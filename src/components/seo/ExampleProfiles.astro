---
// Four worked profiles, each scored at build time by the same engine as the
// live calculator and compared with the latest draw for its stream.
import { calculateTotalPoints } from "../../utils/calculatePoints";
import { EXAMPLE_PROFILES } from "../../data/example-profiles";
import { latestFor, STREAM_SHORT } from "../../utils/draws";

interface Props {
  /** Show only these profile ids (default: all four). */
  only?: string[];
  headingLevel?: "h3" | "h4";
}
const { only, headingLevel = "h3" } = Astro.props;
const H = headingLevel;

const profiles = EXAMPLE_PROFILES.filter((p) => !only || only.includes(p.id)).map((p) => {
  const r = calculateTotalPoints(p.state);
  const b = r.breakdown;
  const draw = latestFor(p.stream);
  return {
    ...p,
    total: r.total,
    rows: [
      ["Work experience", b.experience + b.canadianExp + b.currentBCJob, 40],
      ["Education", b.educationTotal, 40],
      ["Language", b.languageTotal, 40],
      ["Hourly wage", b.wage, 55],
      ["Area of employment", b.area + b.regionalBonus, 25],
    ] as [string, number, number][],
    draw,
    drawLabel: STREAM_SHORT[p.stream],
  };
});
---

<div class="grid gap-5 sm:grid-cols-2">
  {
    profiles.map((p) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-5" id={`example-${p.id}`}>
        <H class="font-black text-slate-900 leading-snug">{p.title}</H>
        <p class="text-xs text-slate-500 mt-1">NOC {p.noc} · {p.location}</p>
        <ul class="mt-3 space-y-1 text-sm text-slate-600 list-disc pl-5">
          {p.facts.map((f) => <li>{f}</li>)}
        </ul>
        <table class="mt-4 w-full text-sm">
          <caption class="sr-only">SIRS breakdown for {p.title}</caption>
          <tbody class="divide-y divide-slate-100">
            {p.rows.map(([label, pts, max]) => (
              <tr>
                <th scope="row" class="py-1.5 text-left font-medium text-slate-600">{label}</th>
                <td class="py-1.5 text-right font-bold text-slate-900">{pts} / {max}</td>
              </tr>
            ))}
            <tr>
              <th scope="row" class="py-2 text-left font-black text-slate-900">SIRS score</th>
              <td class="py-2 text-right text-lg font-black text-red-600">{p.total} / 200</td>
            </tr>
          </tbody>
        </table>
        <p class="mt-3 text-sm text-slate-700">
          Latest {p.drawLabel} minimum: <strong>{p.draw.score}</strong> ({p.draw.date}).{" "}
          {p.total >= (p.draw.score as number) ? (
            <span class="font-bold text-green-700">{p.total - (p.draw.score as number)} points above.</span>
          ) : (
            <span class="font-bold text-amber-700">{(p.draw.score as number) - p.total} points below.</span>
          )}
        </p>
      </article>
    ))
  }
</div>
<p class="mt-4 text-xs text-slate-500 leading-relaxed">
  Scored by this site's calculator using the point values in Part 8 of the
  <a href="https://www.welcomebc.ca/immigrate-to-b-c/bc-pnp-si-program-guide-pdf" target="_blank" rel="noopener noreferrer" class="underline">BC PNP Skills Immigration Program Guide</a>
  (effective June 10, 2026). Draw minimums from
  <a href="https://www.welcomebc.ca/immigrate-to-b-c/about-the-bc-provincial-nominee-program/invitations-to-apply" target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC's invitations page</a>.
  Wages are example offers, not wage data: a real offer must fall within the WorkBC or Job Bank range for the occupation and region (Program Guide section 3.9).
</p>
