---
// "Related calculators and guides": 8–12 query-worded links placed inside the
// page content (not the menu), like calcultaxesquebec's "Autres calculatrices
// et ressources". Anchors come from src/data/site-links.ts.
import { LINKS, RELATED_ORDER, type LinkKey } from "../../data/site-links";

interface Props {
  /** Path of the current page, e.g. "/bc-pnp-draws". Excluded from the list. */
  current: string;
  /** Keys to put first (still deduplicated). */
  first?: LinkKey[];
  /** Maximum number of links (8–12). */
  max?: number;
}

const { current, first = [], max = 12 } = Astro.props;
const norm = (p: string) => (p.length > 1 ? p.replace(/\/$/, "") : p);
const keys = [...new Set([...first, ...RELATED_ORDER])]
  .filter((k) => norm(LINKS[k].href) !== norm(current))
  .slice(0, max);
---

<section class="max-w-4xl mx-auto px-4 sm:px-6 py-8" aria-labelledby="related-heading">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
    <h2 id="related-heading" class="text-lg sm:text-xl font-black text-slate-900 mb-4">
      Related calculators and guides
    </h2>
    <ul class="grid gap-x-6 gap-y-2.5 sm:grid-cols-2 text-sm leading-snug">
      {
        keys.map((k) => (
          <li class="flex gap-2">
            <span class="text-red-600 font-black" aria-hidden="true">›</span>
            <a href={LINKS[k].href} class="text-slate-800 font-semibold underline decoration-red-200 underline-offset-2 hover:text-red-700 hover:decoration-red-600">
              {LINKS[k].anchor}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
