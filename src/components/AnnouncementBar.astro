---
// Site-wide "Advertise with us" notification bar.
// Sits above the sticky header and scrolls away with the page so it never
// eats into the mobile viewport. Dismissal is remembered for 7 days.

interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

const phoneDisplay = "905-626-9919";
const phoneHref = "tel:+19056269919";

const labels = {
  en: {
    short: "Advertise here?",
    long: "Looking to advertise on this website?",
    cta: "Call",
    close: "Dismiss notification",
  },
  zh: {
    short: "投放廣告？",
    long: "想在本網站投放廣告？",
    cta: "致電",
    close: "關閉通知",
  },
};

const l = labels[lang as keyof typeof labels] || labels.en;
---

<div
  id="announcement-bar"
  role="region"
  aria-label="Advertising notice"
  class="relative bg-slate-900 text-white"
>
  <div class="max-w-7xl mx-auto pl-4 pr-12 sm:px-12 min-h-[44px] flex items-center justify-center gap-x-2 text-[13px] sm:text-sm leading-tight text-center">
    <span class="sm:hidden font-semibold">{l.short}</span>
    <span class="hidden sm:inline font-semibold">{l.long}</span>
    <a
      href={phoneHref}
      id="announcement-bar-phone"
      class="inline-flex items-center gap-1.5 min-h-[44px] px-2 font-bold text-red-400 hover:text-red-300 whitespace-nowrap"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
      </svg>
      <span class="underline underline-offset-2"><span class="hidden sm:inline">{l.cta} </span>{phoneDisplay}</span>
    </a>
  </div>
  <button
    type="button"
    id="announcement-bar-close"
    aria-label={l.close}
    class="absolute right-0 top-0 w-11 h-11 flex items-center justify-center text-slate-400 hover:text-white transition-colors"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script is:inline>
  // Runs synchronously right after the bar is parsed, so a dismissed bar is
  // hidden before first paint (no layout shift).
  (function () {
    var KEY = "announcement-bar-dismissed";
    var TTL = 7 * 24 * 60 * 60 * 1000;
    var bar = document.getElementById("announcement-bar");
    var close = document.getElementById("announcement-bar-close");
    if (!bar || !close) return;
    try {
      var at = Number(localStorage.getItem(KEY));
      if (at && Date.now() - at < TTL) bar.remove();
    } catch (e) {}
    close.addEventListener("click", function () {
      bar.remove();
      try {
        localStorage.setItem(KEY, String(Date.now()));
      } catch (e) {}
    });
  })();
</script>
