        <div class="text-3xl font-black text-indigo-600 mb-2">719</div>
        <div class="text-sm text-slate-600 font-medium">ECE invitations in six 2026 Childcare draws</div>
      </div>
      <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center">
        <div class="text-3xl font-black text-green-600 mb-2">99</div>
        <div class="text-sm text-slate-600 font-medium">Minimum score, Sept 10 and Oct 8, 2026</div>
      </div>
      <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center">
        <div class="text-3xl font-black text-red-600 mb-2">2,957</div>
