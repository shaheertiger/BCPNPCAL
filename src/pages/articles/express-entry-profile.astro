---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Express Entry Profile 2026: How to Create, Update and Keep It Valid";
const description = "How to create an Express Entry profile in 2026: documents, IRCC account steps, profile number, 12-month validity, Nov 3 updates and the 60-day ITA deadline.";
const canonical = "https://bcpnpcalculator.ca/articles/express-entry-profile";

const faqs = [
  {
    q: "How do I create an Express Entry profile?",
    a: "Prepare your documents first, then sign in to your IRCC secure account (or create one), enter your personal reference code if you used the Come to Canada tool, and fill in the profile sections: personal details, language test results, education, work history and funds. IRCC gives you 60 days to finish and submit a profile you have started; after that you have to start again. Once you submit, IRCC checks which federal program you may qualify for and, if you are eligible, places you in the pool with a CRS score.",
  },
  {
    q: "Is there a fee to create an Express Entry profile?",
    a: "No. IRCC's fee list has no charge for submitting a profile. Government fees are paid only if you are invited and apply for permanent residence: as of November 15, 2026 the fee list shows $1,590 for a principal applicant (a $990 processing fee plus the $600 right of permanent residence fee) and $270 per dependent child. You will still pay outside providers for a language test and, for foreign education, an educational credential assessment.",
  },
  {
    q: "How long is an Express Entry profile valid?",
    a: "Twelve months from the day you submit it. IRCC says a profile expires 12 months after submission if you are not invited to apply, is removed from the system, and you get a message in your account. You can then submit a new profile if you still qualify. Don't create a second profile while the first is still active: withdraw the old one first or wait for it to expire.",
  },
  {
    q: "How do I update my Express Entry profile?",
    a: "Sign in, go to View the applications you submitted, choose Check full application status, open your Express Entry profile, and click Update form on the section you want to change. Save and exit, then click Continue and follow the steps to submit the updated profile. You can only update a profile that was found eligible for the pool. If you only see View form buttons, the profile was not eligible and you need to submit a new one.",
  },
  {
    q: "Where do I find my Express Entry profile number?",
    a: "In the PDF letter IRCC posts to your secure account after your profile is accepted into the pool. The profile number is at the top of the letter, and the Job Seeker Validation Code appears in the same letter under the Job Bank heading. Both are tied to that profile, so a new profile comes with new numbers.",
  },
  {
    q: "Do I need to update my profile because of the November 3, 2026 changes?",
    a: "IRCC recalculates existing profiles automatically, but if you have a job offer you should check how it is entered. Since November 3, 2026, a job offer no longer needs an LMIA to count, yet IRCC says its online form has not caught up. Until it does, IRCC tells candidates to answer Yes to the positive LMIA question under Work history and enter LMIA number 00000, issuance date 2026-01-01 and expiry date 2029-01-01. Job offer points now go only to offers in high-wage occupations.",
  },
  {
    q: "How long do I have to apply after an invitation?",
    a: "Sixty days. IRCC says the invitation to apply is valid for 60 days only, and you must submit a complete permanent residence application, with your processing fees at minimum, before it expires. Your language test results and ECA must still be valid on the day you submit, so check their dates before the invitation arrives.",
  },
  {
    q: "Why does the BC PNP ask for my Express Entry profile number and Job Seeker Validation Code?",
    a: "Only if you register under an Express Entry BC (EEBC) option, available in the Skilled Worker and Health Authority streams. B.C.'s Skills Immigration Program Guide says you get these numbers when you meet the criteria for a federal Express Entry program, and that you must also indicate interest in settling in B.C. The BC PNP can only nominate you if your profile is still valid and visible to it, so an expired profile, or an ITA accepted before nomination, can block an EEBC nomination.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
