<ArticleLayout slug="nova-scotia-pnp-guide" datePublished="2026-11-12" dateModified="2026-11-12" articleSection="Guide" keywords="nova scotia pnp, pnp nova scotia, ns pnp, pnp in nova scotia, novascotia pnp, canada nova scotia pnp, nova scotia pnp application, nova scotia pnp requirements, nova scotia pnp quota 2026" ogImage="/images/articles/nova-scotia-pnp-guide.png" title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto px-4 py-12">
