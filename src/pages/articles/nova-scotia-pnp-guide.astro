---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Nova Scotia PNP Guide 2026: NSNP Streams, Requirements, Fees and Quota";
const description = "Nova Scotia PNP guide for late 2026: the four NSNP streams, requirements, EOI selection, the new $1,000 fee, processing times, 2026 quota and BC PNP vs AIP.";
const canonical = "https://bcpnpcalculator.ca/articles/nova-scotia-pnp-guide";

const faqs = [
  {
    q: "What are the Nova Scotia PNP streams in 2026?",
    a: "As of November 12, 2026, the Nova Scotia Nominee Program lists four streams: Skilled Worker, Nova Scotia Graduate, Nova Scotia: Express Entry and Entrepreneur. Several older pathways now sit inside them as categories, for example Physicians and Occupations in Demand under Skilled Worker, and International Graduate Entrepreneur under Entrepreneur. The province closed its portal from February 13 to 18, 2026 to modernize forms and consolidate streams.",
  },
  {
    q: "Can I apply directly to the Nova Scotia PNP?",
    a: "No. Every NSNP stream starts with an online Expression of Interest (EOI) in the eNSNP portal. Your EOI goes into a pool and the province selects candidates based on its priorities and the nomination spaces it has. Selection is not first come, first served. An EOI is valid for 12 months, a rule in force since May 1, 2026.",
  },
  {
    q: "How much does the Nova Scotia PNP cost?",
    a: "Submitting an EOI is free. Since September 1, 2026, candidates selected from the pool pay a non-refundable provincial fee of $1,000 per principal applicant for the worker streams (Skilled Worker, Nova Scotia Graduate and Nova Scotia: Express Entry) or $2,000 for the Entrepreneur stream. If nominated, you also pay IRCC's permanent residence fees: $1,590 for a principal applicant including the right of permanent residence fee.",
  },
  {
    q: "What is the Nova Scotia PNP quota for 2026?",
    a: "Nova Scotia had not published an official 2026 nomination allocation on its immigration site as of November 12, 2026. For context, the federal government cut the province's combined NSNP and Atlantic Immigration Program allocation from 6,300 in 2024 to 3,150 in 2025, then added 559 spaces later in 2025 for a total of 3,709. Press estimates for 2026 vary and are not official.",
  },
  {
    q: "Do I need a job offer for the Nova Scotia PNP?",
    a: "For most applicants, yes. The Skilled Worker and Nova Scotia Graduate streams require a full-time, permanent job offer from a Nova Scotia employer. The Nova Scotia: Express Entry stream instead requires at least one year of skilled work experience in Nova Scotia and an active Express Entry profile. The Entrepreneur stream requires you to start or buy and run a business in the province.",
  },
  {
    q: "How long does the Nova Scotia PNP take?",
    a: "Nova Scotia does not publish a fixed provincial processing time. After nomination, IRCC's own processing is the longer step: in IRCC data dated September 3, 2026, as reported by CIC News, base (paper) PNP applications took about 13 months and Express Entry-linked PNP applications about 7 months. Check IRCC's processing times tool for the current figure.",
  },
  {
    q: "Is the Nova Scotia PNP easier than the BC PNP?",
    a: "Neither is easy, and they reward different profiles. Nova Scotia's language minimum can be as low as CLB 4 for TEER 4 and 5 jobs and it accepts some intermediate-skilled workers, but in 2026 it is prioritizing healthcare, skilled trades and people already working in the province. The BC PNP Skills Immigration streams require a TEER 0 to 3 job offer and rank candidates on a points score. Compare your profile with our BC PNP calculator before choosing.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
