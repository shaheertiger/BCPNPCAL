                                <td class="px-4 py-3 text-red-600"
                                    >Closed</td
                                >
                            </tr>
                            <tr>
                                <td class="px-4 py-3 font-semibold"
                                    >Priority Sectors</td
                                >
                                <td class="px-4 py-3"
                                    >Healthcare, Entrepreneurs</td
                                >
