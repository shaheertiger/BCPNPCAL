---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Alberta PNP Draws 2026: Latest AAIP Draw Results, Scores and Trends";
const description = "Alberta PNP draws in 2026: latest AAIP draw dates, invitations and minimum EOI scores by stream from alberta.ca, how draws work and how to raise your score.";
const canonical = "https://bcpnpcalculator.ca/articles/alberta-pnp-draws";

const faqs = [
  {
    q: "When was the latest Alberta PNP draw?",
    a: "As of the AAIP processing information page last updated November 4, 2026, the most recent draw was on November 2, 2026: a Rural Renewal Stream draw that invited 173 candidates with a minimum score of 51. The draw before that, on October 30, 2026, invited 132 Alberta Opportunity Stream candidates with a minimum score of 59.",
  },
  {
    q: "When will the next Alberta PNP draw be?",
    a: "Nobody outside the program knows. Alberta says AAIP draws are not regularly scheduled and are held as needed to address sector needs and provincial priorities. In 2026 the program held 95 draws between January 26 and November 2, often several a week, but it does not announce draws in advance. Check the alberta.ca processing information page, which lists each draw after it happens.",
  },
  {
    q: "What is a good EOI score for Alberta PNP?",
    a: "It depends on the stream you are drawn in. In 2026 the minimum score of invited candidates ranged from 45 (Dedicated Health Care Pathway, non-Express Entry) to 73 (Tourism and Hospitality Stream). Alberta Opportunity Stream draws ranged from 50 to 65, and most Alberta Express Entry Accelerated Tech draws from 55 to 63. The maximum Worker EOI score is 100, and score is not the only selection factor.",
  },
  {
    q: "Why are Alberta PNP draw scores different for each stream?",
    a: "Each draw selects from one stream, pathway or sector, so candidates compete only with others who match that draw's parameters. Pool sizes and allocations differ sharply: as of November 4, 2026 the Alberta Opportunity Stream had 20,603 EOIs in the pool, while the Tourism and Hospitality Stream had 2,846 EOIs competing for a 2026 allocation of 156 nominations. AAIP also uses occupation, employer industry and other EOI details that do not earn points, and it does not disclose draw parameters.",
  },
  {
    q: "How long is an Alberta Worker EOI valid and how much does it cost?",
    a: "Since April 7, 2026, submitting a Worker Expression of Interest costs $135, paid online within 24 hours of submission. A WEOI created on or after that date is valid for one year from the date the fee was paid. If you are not selected within 12 months it is cancelled, and you must submit a new WEOI and pay the fee again to stay in the pool.",
  },
  {
    q: "What happens after I get an AAIP invitation?",
    a: "You have 15 days to open the invitation link and create a draft application, or the WEOI returns to the pool. Once you create the application you have 30 days to complete and submit it, then 24 hours to pay the $1,500 worker stream application fee. While the application is in progress you are removed from the WEOI pool. If AAIP approves it you are nominated and can apply to IRCC for permanent residence.",
  },
  {
    q: "Can Alberta invite me to a different stream than the one I chose?",
    a: "Yes. Alberta's instructions say that you indicate a preferred stream in your Worker EOI, but there is no guarantee you will be invited to that stream or at all, and AAIP may invite you to apply to a different stream or pathway. Review the eligibility rules of the stream named in your invitation before accepting it.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
