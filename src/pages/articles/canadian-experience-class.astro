<ArticleLayout slug="canadian-experience-class" datePublished="2026-11-15" dateModified="2026-11-15" articleSection="Guide" keywords="canadian experience class, canada experience class, cec canada, cec express entry, canadian experience class requirements, cec draw" ogImage="/images/articles/canadian-experience-class.png" title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <div class="inline-block bg-emerald-100 text-emerald-800 px-4 py-1 rounded-full text-sm font-bold mb-4 border border-emerald-200 shadow-sm">
