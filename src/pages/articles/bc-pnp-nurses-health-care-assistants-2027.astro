<ArticleLayout slug="bc-pnp-nurses-health-care-assistants-2027" datePublished="2026-10-14" dateModified="2026-10-14" articleSection="Occupation Guide" keywords="BC PNP nurses 2027, BC PNP health care assistant, BCCNM internationally educated nurse, BC Care Aide Registry, Health Authority stream, NOC 31301, NOC 33102" title={title} description={description} canonical={canonical}>
