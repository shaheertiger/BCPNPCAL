---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "BC PNP for Nurses and Health Care Assistants in 2027: Registration, Timelines and the Best Stream";
const description = "BC PNP guide for nurses and HCAs: BCCNM and Care Aide Registry steps, Health Authority stream vs targeted Health draws, 2026 cutoffs and score examples.";
const canonical = "https://bcpnpcalculator.ca/articles/bc-pnp-nurses-health-care-assistants-2027";

const faqs = [
  {
    q: "Do internationally educated nurses still have to go through NNAS to work in B.C.?",
    a: "No. Since B.C. changed its process in 2023, NNAS is no longer the only route for credential checks. BCCNM's current instructions say internationally educated nurses start with Inspire Global Assessments, which checks identity, English, education and nursing competence, and apply to BCCNM at the same time. BCCNM assesses most applicants for both LPN and RN licensure in a single application."
  },
  {
    q: "Should a nurse use the Health Authority stream or wait for a targeted Health draw?",
    a: "If a B.C. public health authority employs you, or will hire you, in a regular, indeterminate, full-time role and agrees to support you, the Health Authority stream is usually the better route because you apply directly without registering or waiting for a draw. Nurses with offers from private employers, such as private long-term care homes or clinics, use the Skilled Worker stream and compete in targeted Health draws."
  },
  {
    q: "Do health care assistants need to be on the BC Care Aide Registry for the BC PNP?",
    a: "Yes. The BC PNP program guide says anyone with a job offer under NOC 33102 must be on the BC Care Aide & Community Health Worker Registry. Registration is also required to receive a targeted Health invitation and earns 5 professional designation points."
  },
  {
    q: "What score did health workers need in the 2026 BC PNP draws?",
    a: "WelcomeBC's invitations page shows six Health draws for all priority health care occupations between May 6 and October 8, 2026. The minimum score fell from 108 in May to 76 in September and October, with 82 to 143 invitations per draw."
  },
  {
    q: "Can I work as an LPN while I finish my RN requirements?",
    a: "BCCNM says that because most internationally educated nurses are assessed for both LPN and RN licensure in one application, you can choose to enter the workforce as an LPN while completing your RN requirements, without reapplying."
  },
  {
    q: "Will the BC PNP still prioritize nurses and HCAs in 2027?",
    a: "B.C. has not announced its 2027 priorities or allocation. As of October 14, 2026, registered nurses, licensed practical nurses and registered HCAs are all on the BC PNP's Care health list and the Health Authority stream continues. We expect health care to remain a priority, but invitation numbers and cutoffs in 2027 are not known."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
