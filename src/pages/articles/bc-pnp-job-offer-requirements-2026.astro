---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { calculateTotalPoints } from "../../utils/calculatePoints";
import { BLANK } from "../../data/example-profiles";
import { latestFor, latestHeiWage } from "../../utils/draws";
import { LINKS } from "../../data/site-links";
import { TECH_NOCS } from "../../data/tech-nocs";

const title = "BC PNP Job Offer Requirements 2026: Full-Time, Indeterminate, Job Bank Wage";
const description =
  "Your offer must average 30+ hours a week year-round, have no end date and pay within the Job Bank range, from a B.C. employer operating 1+ year.";

const GUIDE = "https://www.welcomebc.ca/immigrate-to-b-c/bc-pnp-si-program-guide-pdf";
const SKILLS = "https://www.welcomebc.ca/immigrate-to-b-c/skills-immigration";

// Worked example: the same licensed practical nurse offer (NOC 32101) in
// Nanaimo (Area 3) and in Burnaby (Area 1), scored by the site's calculator.
// The wage is an example offer, not wage data.
const lpnState = {
  ...BLANK,
  experience: "2" as const,
  hasCanadianExp: true,
  hasCurrentBCJob: true,
  education: "trades_cert" as const,
  hasCanadianEducation: true,
  educationLocation: "bc" as const,
  hasProfessionalDesignation: true,
  selectedProfession: "Licensed Practical Nurse (BCCNM)",
  hasEnglishTest: true,
  englishClb: 7 as const,
  hourlyWage: 35,
  area: "area3" as const,
};
const nanaimo = calculateTotalPoints(lpnState);
const burnaby = calculateTotalPoints({ ...lpnState, area: "area1" });
const offerPts = (r: typeof nanaimo) => r.breakdown.wage + r.breakdown.area + r.breakdown.regionalBonus;
const health = latestFor("health");
const heiWage = latestHeiWage;

const faqs = [
  {
    q: "Does a BC PNP job offer need an LMIA?",
    a: "No. The Skills Immigration Program Guide asks for a job offer from an eligible B.C. employer with a signed Employer Declaration Form, not a Labour Market Impact Assessment. You may still need an LMIA-based work permit to start working before nomination.",
  },
  {
    q: "Can my BC PNP job offer have an end date?",
    a: `Usually not: the offer must be indeterminate. Appendix A of the Program Guide lists exceptions (university professors, public K-12 teachers and ${TECH_NOCS.length} technology occupations) where an offer of at least one year, with at least 120 days left at application, can qualify.`,
  },
  {
    q: "Can I use a part-time job offer?",
    a: "No. The offer must be for one regular full-time position, which the BC PNP defines as an average of at least 30 hours a week, year-round. Two part-time jobs cannot be combined.",
  },
  {
    q: "Can a company owned by my family support my application?",
    a: "No, if you or your immediate or extended family have held or controlled 10% or more of the organization in the 5 years before your application (section 6.12(e)).",
  },
  {
    q: "Is there a minimum wage for a BC PNP job offer?",
    a: "There is no single wage floor. The wage must be within the WorkBC or Job Bank range for the occupation and region, and your family income must meet the BC PNP minimum (for one person, $31,264 in Metro Vancouver or $26,057 elsewhere in B.C.).",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};

const rows: [string, string, string][] = [
  ["Occupation", "Skilled Worker: NOC TEER 0, 1, 2 or 3. Health Authority: eligible health occupation with a B.C. public health authority. Not one of the 12 ineligible occupations.", "3.5(a), 3.11, 4.1(b), 4.2(c)"],
  ["Hours", "One regular full-time position: an average of at least 30 hours a week, year-round", "3.5(b)"],
  ["Duration", "Indeterminate (no end date), except Appendix A occupations: 1+ year offer with 120+ days left", "3.5(c), Appendix A"],
  ["Wage", "Within the WorkBC or Job Bank range for the occupation and location, comparable to Canadian workers, consistent with the employer's pay structure", "3.9"],
  ["Employer support", "Employer agrees before you register and signs the Employer Declaration Form", "3.6, 6.4"],
  ["Time in operation", "Employer has operated in B.C. for at least 1 year", "6.7"],
  ["Employees", "At least 5 indeterminate full-time employees in B.C. (Metro Vancouver) or 3 (rest of B.C.)", "6.8"],
  ["Ownership", "You and your family hold or control less than 10% of the employer, now and in the past 5 years", "3.12, 6.12(e)"],
  ["Employer type", "Not a placement or staffing agency, sexually oriented business or (with limited exceptions) an immigration services firm", "6.12"],
];
const ineligible = [
  "12100 Executive assistants",
  "12101 Human resources and recruitment officers",
  "12200 Accounting technicians and bookkeepers",
  "13100 Administrative officers",
  "13110 Administrative assistants",
  "13111 Legal administrative assistants",
  "13112 Medical administrative assistants",
  "62010 Retail sales supervisors",
  "62020 Food service supervisors",
  "63101 Real estate agents and salespersons",
  "41302 Religious leaders",
  "42204 Religious workers",
];

const h2 = "text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-12 mb-4";
const p = "text-slate-700 text-base sm:text-lg leading-relaxed mb-4";
const a = "text-red-600 font-semibold underline underline-offset-2 hover:text-red-700";
const src = "underline underline-offset-2 hover:text-red-600";
---

<ArticleLayout
  slug="bc-pnp-job-offer-requirements-2026"
  datePublished="2026-02-09"
  dateModified="2026-11-26"
  articleSection="Eligibility"
  breadcrumbLabel="Job Offer Requirements"
  keywords="BC PNP job offer requirements, BC PNP wage requirement, BC PNP employer requirements, BC PNP job offer"
  title={title}
  description={description}
  jsonLd={jsonLd}
  related={["workExperience", "withoutJobOffer", "caregivers", "tech"]}
  canonical="https://bcpnpcalculator.ca/articles/bc-pnp-job-offer-requirements-2026"
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <header class="mb-6">
      <p class="text-sm font-bold text-red-600 uppercase tracking-widest mb-3">Eligibility · Updated November 26, 2026</p>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        What are the BC PNP job offer requirements?
      </h1>
    </header>

    <p class={p}>
      A BC PNP job offer must be for one regular full-time position (an average of at least 30 hours a week, year-round), indeterminate (no end date), in an eligible occupation, paid within the WorkBC or Job Bank wage range, and from an eligible B.C. employer that agrees to support you. Every Skills Immigration stream needs one, and the offer's wage and location decide 80 of your 200 points in the <a href={LINKS.calculator.href} class={a}>{LINKS.calculator.short}</a>.
    </p>

    <aside class="rounded-2xl border border-red-100 bg-red-50/60 p-5 sm:p-6 my-8" aria-label="Key facts">
      <p class="font-black text-slate-900 mb-3">Key facts</p>
      <ul class="space-y-2 text-slate-700 text-sm sm:text-base list-disc pl-5">
        <li><strong>Full-time:</strong> an average of 30+ hours a week, year-round (Program Guide 3.5(b)).</li>
        <li><strong>Indeterminate:</strong> no end date, except listed occupations with a 1+ year offer (3.5(c), Appendix A).</li>
        <li><strong>Occupation:</strong> NOC TEER 0–3 for Skilled Worker; 12 occupations are ineligible for every stream (3.11).</li>
        <li><strong>Employer:</strong> 1+ year operating in B.C.; 5 full-time employees in Metro Vancouver, 3 elsewhere (6.7, 6.8).</li>
        <li><strong>No LMIA</strong> is needed for the BC PNP itself.</li>
      </ul>
    </aside>

    <h2 class={h2}>What do you need in a BC PNP job offer?</h2>
    <div class="overflow-x-auto rounded-2xl border border-slate-200 my-6">
      <table class="w-full text-sm text-left">
        <caption class="sr-only">BC PNP job offer and employer requirements</caption>
        <thead class="bg-slate-100 text-slate-900">
          <tr><th scope="col" class="px-4 py-3 font-bold">Requirement</th><th scope="col" class="px-4 py-3 font-bold">Rule</th><th scope="col" class="px-4 py-3 font-bold">Section</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {rows.map(([r, rule, sec]) => (
            <tr><th scope="row" class="px-4 py-2.5 text-left font-bold text-slate-900 align-top">{r}</th><td class="px-4 py-2.5 text-slate-700">{rule}</td><td class="px-4 py-2.5 text-slate-500 whitespace-nowrap align-top">{sec}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-slate-500 -mt-3 mb-6">Source: <a href={GUIDE} target="_blank" rel="noopener noreferrer" class={src}>BC PNP Skills Immigration Program Guide</a> (effective June 10, 2026) and <a href={SKILLS} target="_blank" rel="noopener noreferrer" class={src}>WelcomeBC Skills Immigration</a>.</p>

    <h2 class={h2}>What is the BC PNP wage requirement?</h2>
    <p class={p}>
      There is no fixed minimum wage. Your offered wage must be within the range WorkBC or Job Bank posts for your occupation and location, comparable to what Canadians with similar experience earn, and consistent with the employer's pay structure. Bonuses, commissions, tips, overtime and housing allowances do not count. Your family income must also clear the minimum in section 3.10: for a single person, $31,264 in Metro Vancouver or $26,057 elsewhere in B.C.
    </p>
    <p class={p}>
      Wage matters a second time in draws. The latest High Economic Impact draw on {heiWage.date} invited candidates earning at least {heiWage.rule}, with no score cut-off.
    </p>

    <h2 class={h2}>What are the BC PNP employer requirements?</h2>
    <p class={p}>
      Beyond the table: two part-time employees can count as one full-time equivalent, contractors do not count, and the employer must pay you, direct your work and have a significant operational presence in B.C.
    </p>

    <h2 class={h2}>Which jobs are ineligible for BC PNP?</h2>
    <p class={p}>
      Section 3.11 lists 12 occupations that are not eligible for any Skills Immigration stream, for applications submitted after June 13, 2026:
    </p>
    <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-1 list-disc pl-6 text-slate-700 mb-4">
      {ineligible.map((o) => <li>{o}</li>)}
    </ul>

    <h2 class={h2}>How much does the job offer add to your BC PNP score?</h2>
    <p class={p}>
      Consider a licensed practical nurse (NOC 32101) with a B.C. nursing diploma, BCCNM licence, 2 years with the current employer, CLB 7 and an example offer of $35.00 an hour. In Nanaimo (Area 3) the calculator gives {offerPts(nanaimo)} points for wage and area and a total of <strong>{nanaimo.total}</strong>. The identical offer in Burnaby (Area 1) gives {offerPts(burnaby)} and a total of <strong>{burnaby.total}</strong>.
    </p>
    <p class={p}>
      Both clear the latest Care: Health minimum of {health.score} ({health.date}); compare other streams on the <a href={LINKS.draws.href} class={a}>{LINKS.draws.short}</a> page. Experience is the other half of eligibility, covered in <a href={LINKS.workExperience.href} class={a}>{LINKS.workExperience.short}</a>.
    </p>

    <h2 class={h2}>Common mistakes</h2>
    <ul class="list-disc pl-6 space-y-2 text-slate-700 text-base sm:text-lg mb-4">
      <li>Accepting a contract or term offer in an occupation that is not on the Appendix A list.</li>
      <li>Counting bonuses, tips or overtime as part of the hourly wage.</li>
      <li>Using an employer with too few full-time staff in B.C., or with contractors counted as employees.</li>
      <li>An offer from a staffing agency, or from a company you or a relative own 10% or more of.</li>
      <li>Paying for a job: in B.C. it is illegal to buy jobs or ask for money in exchange for one (section 1.7).</li>
    </ul>

    <h2 class={h2}>Frequently asked questions</h2>
    <div class="space-y-4">
      {faqs.map((f) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-900 mb-2">{f.q}</h3>
          <p class="text-slate-700 leading-relaxed">{f.a}</p>
        </div>
      ))}
    </div>

    <p class="text-xs text-slate-500 mt-8">
      Sources: <a href={GUIDE} target="_blank" rel="noopener noreferrer" class={src}>Skills Immigration Program Guide</a> sections 1.7, 3.5–3.12, 6.4–6.12 and Appendix A (effective June 10, 2026); draw data from <a href="https://www.welcomebc.ca/immigrate-to-b-c/about-the-bc-provincial-nominee-program/invitations-to-apply" target="_blank" rel="noopener noreferrer" class={src}>WelcomeBC invitations to apply</a>. General information, not legal advice.
    </p>
  </article>
</ArticleLayout>
