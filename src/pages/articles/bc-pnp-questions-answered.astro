                    <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">What earns the points</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                  <tr><td class="px-4 py-3 font-medium">Work experience</td><td class="px-4 py-3">40</td><td class="px-4 py-3">Directly related experience (up to 20), 1+ year of it in Canada (10), currently working full-time for the employer (10)</td></tr>
                  <tr><td class="px-4 py-3 font-medium">Education</td><td class="px-4 py-3">40</td><td class="px-4 py-3">Highest level (up to 27), completed in B.C. (8) or elsewhere in Canada (6), eligible professional designation (5)</td></tr>
                  <tr><td class="px-4 py-3 font-medium">Language</td><td class="px-4 py-3">40</td><td class="px-4 py-3">CLB 4 (5 points) to CLB 9+ (30 points), plus 10 for English and French at CLB 4+</td></tr>
                  <tr><td class="px-4 py-3 font-medium">Hourly wage</td><td class="px-4 py-3">55</td><td class="px-4 py-3">Rises with each $1 of base hourly pay; $70+ earns the maximum</td></tr>
                  <tr><td class="px-4 py-3 font-medium">Area of employment</td><td class="px-4 py-3">25</td><td class="px-4 py-3">Area 2 (5) or Area 3 (15), plus 10 for regional experience or regional alumni</td></tr>
                  <tr class="bg-slate-50"><td class="px-4 py-3 font-bold">Total</td><td class="px-4 py-3 font-bold">200</td><td class="px-4 py-3">Draws rank you within the group you qualify for</td></tr>
                </tbody>
              </table>
            </div>
          )}

          {g.items.map((f) => (
            <div class="mt-8">
              <h3 class="text-2xl font-semibold mt-8 mb-3">{f.q}</h3>
              <p>{f.a}</p>
              <p class="text-base mt-2">
                <span class="font-semibold text-slate-700">In depth: </span>
                {f.links.map((l, i) => (
                  <>{i > 0 ? " · " : ""}<a href={l.href} class={linkClass}>{l.label}</a></>
                ))}
              </p>
            </div>
          ))}
        </section>
      ))}

      <div class="bg-blue-50 border-l-4 border-blue-500 p-6 my-10">
        <p class="font-semibold text-blue-900 mb-2">Key takeaway</p>
        <p class="text-blue-800">In 2026 the two questions that decide most BC PNP cases are whether your job offer and employer qualify, and which draw group your occupation and credentials put you in. Settle those before worrying about a few points either way.</p>
      </div>

