          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="px-4 py-3">30010</td><td class="px-4 py-3">Managers in health care</td><td class="px-4 py-3">Depends on the role; often not a licensed title on its own</td></tr>
            <tr><td class="px-4 py-3">31100</td><td class="px-4 py-3">Specialists in clinical and laboratory medicine</td><td class="px-4 py-3">College of Physicians and Surgeons of BC (CPSBC)</td></tr>
            <tr><td class="px-4 py-3">31101</td><td class="px-4 py-3">Specialists in surgery</td><td class="px-4 py-3">CPSBC</td></tr>
            <tr><td class="px-4 py-3">31102</td><td class="px-4 py-3">General practitioners and family physicians</td><td class="px-4 py-3">CPSBC; internationally trained family physicians may go through Practice Ready Assessment BC (PRA-BC)</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-2xl font-semibold mt-8 mb-4">Group 2: Nursing and direct care</h3>
      <div class="overflow-x-auto my-6">
        <table class="min-w-full border border-slate-200 rounded-lg overflow-hidden text-sm">
          <thead class="bg-slate-100">
            <tr><th class="px-4 py-3 text-left font-bold text-slate-700">NOC</th><th class="px-4 py-3 text-left font-bold text-slate-700">Occupation</th><th class="px-4 py-3 text-left font-bold text-slate-700">Licensing to check</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="px-4 py-3">31300</td><td class="px-4 py-3">Nursing coordinators and supervisors</td><td class="px-4 py-3">BC College of Nurses and Midwives (BCCNM)</td></tr>
            <tr><td class="px-4 py-3">31301</td><td class="px-4 py-3">Registered nurses and registered psychiatric nurses</td><td class="px-4 py-3">BCCNM</td></tr>
            <tr><td class="px-4 py-3">31302</td><td class="px-4 py-3">Nurse practitioners</td><td class="px-4 py-3">BCCNM</td></tr>
            <tr><td class="px-4 py-3">32101</td><td class="px-4 py-3">Licensed practical nurses</td><td class="px-4 py-3">BCCNM</td></tr>
            <tr><td class="px-4 py-3">33102</td><td class="px-4 py-3">Nurse aides, orderlies and patient service associates</td><td class="px-4 py-3"><strong>Must</strong> be on the BC Care Aide &amp; Community Health Worker Registry</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-2xl font-semibold mt-8 mb-4">Group 3: Professional allied health and therapy</h3>
      <div class="overflow-x-auto my-6">
        <table class="min-w-full border border-slate-200 rounded-lg overflow-hidden text-sm">
          <thead class="bg-slate-100">
            <tr><th class="px-4 py-3 text-left font-bold text-slate-700">NOC</th><th class="px-4 py-3 text-left font-bold text-slate-700">Occupation</th><th class="px-4 py-3 text-left font-bold text-slate-700">Licensing to check</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="px-4 py-3">31110</td><td class="px-4 py-3">Dentists</td><td class="px-4 py-3">BC College of Oral Health Professionals (BCCOHP)</td></tr>
            <tr><td class="px-4 py-3">31112</td><td class="px-4 py-3">Audiologists and speech-language pathologists</td><td class="px-4 py-3">College of Health and Care Professionals of BC (CHCPBC)</td></tr>
            <tr><td class="px-4 py-3">31120</td><td class="px-4 py-3">Pharmacists</td><td class="px-4 py-3">College of Pharmacists of BC</td></tr>
