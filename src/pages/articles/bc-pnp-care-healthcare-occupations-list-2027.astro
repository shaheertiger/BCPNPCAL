---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "BC PNP Care Priority List 2027: All 36 Healthcare, Childcare, Education and Vet Occupations Explained";
const description = "The full BC PNP Care list by NOC: 31 health, 3 education and 2 vet occupations, the licensing you need, the Health Authority stream and how Care draws work.";
const canonical = "https://bcpnpcalculator.ca/articles/bc-pnp-care-healthcare-occupations-list-2027";

const faqs = [
  {
    q: "Which occupations are on the BC PNP Care priority list?",
    a: "The Care objective covers 36 occupations: 31 health care NOC codes (from 30010 managers in health care to 41300 social workers), 3 education codes (French-speaking teachers under 41220 and 41221, and early childhood educators under 42202) and 2 veterinary codes (31103 veterinarians and 32104 animal health technologists and veterinary technicians)."
  },
  {
    q: "Do health care assistants qualify for BC PNP Care draws?",
    a: "Yes, if they are registered. NOC 33102 (nurse aides, orderlies and patient service associates) is on the health list, but a targeted invitation requires registration with the BC Care Aide and Community Health Worker Registry."
  },
  {
    q: "What is the difference between the Health Authority stream and Care: Health draws?",
    a: "The Health Authority stream is for people with a qualifying job offer from a B.C. public health authority, plus some physicians, nurse practitioners and midwives with health authority support. They apply directly without registering or waiting for an invitation. Care: Health draws are for workers in the 31 priority health occupations with any eligible B.C. employer. They must register in the Skills Immigration pool and be invited."
  },
  {
    q: "What score did the BC PNP Care: Health draws need in 2026?",
    a: "Published minimums for Care: Health fell from 108 on May 6, 2026 to 76 on September 10 and October 8, 2026. Childcare draws ranged from 115 down to 99. These are past results, not predictions for 2027."
  },
  {
    q: "Will the Care occupation list change in 2027?",
    a: "As of October 14, 2026 the BC PNP has not announced any 2027 changes to the Care list. The program guide allows selection factors to change at any time, so check the selection of workers page on WelcomeBC before you register."
  },
  {
    q: "Do I need to be licensed before I register for a Care draw?",
    a: "For occupations with a targeting condition (registered HCAs, ECEs with a One Year or Five Year certificate, French-speaking teachers in the public K-12 system, and veterinary technicians with a valid designation), you must meet that condition when invited. For regulated occupations generally, the program guide requires proof of licensing at application or evidence that the requirement will shortly be met."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
