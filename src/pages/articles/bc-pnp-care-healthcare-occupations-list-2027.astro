            <tr><td class="px-4 py-3">31209</td><td class="px-4 py-3">Other professional occupations in health diagnosing and treating</td><td class="px-4 py-3">Varies by occupation</td></tr>
            <tr><td class="px-4 py-3">31303</td><td class="px-4 py-3">Physician assistants, midwives and allied health professionals</td><td class="px-4 py-3">Midwives: BCCNM; others vary</td></tr>
            <tr><td class="px-4 py-3">41300</td><td class="px-4 py-3">Social workers</td><td class="px-4 py-3">BC College of Social Workers</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-2xl font-semibold mt-8 mb-4">Group 4: Technologists, technicians and assistants</h3>
      <div class="overflow-x-auto my-6">
        <table class="min-w-full border border-slate-200 rounded-lg overflow-hidden text-sm">
          <thead class="bg-slate-100">
            <tr><th class="px-4 py-3 text-left font-bold text-slate-700">NOC</th><th class="px-4 py-3 text-left font-bold text-slate-700">Occupation</th><th class="px-4 py-3 text-left font-bold text-slate-700">Licensing to check</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="px-4 py-3">32102</td><td class="px-4 py-3">Paramedical occupations</td><td class="px-4 py-3">Emergency Medical Assistants Licensing Board (EMALB)</td></tr>
            <tr><td class="px-4 py-3">32103</td><td class="px-4 py-3">Respiratory therapists, clinical perfusionists and cardiopulmonary technologists</td><td class="px-4 py-3">Confirm with employer</td></tr>
            <tr><td class="px-4 py-3">32111</td><td class="px-4 py-3">Dental hygienists and dental therapists</td><td class="px-4 py-3">BCCOHP</td></tr>
            <tr><td class="px-4 py-3">32112</td><td class="px-4 py-3">Dental technologists and technicians</td><td class="px-4 py-3">BCCOHP</td></tr>
            <tr><td class="px-4 py-3">32120</td><td class="px-4 py-3">Medical laboratory technologists</td><td class="px-4 py-3">Confirm with employer</td></tr>
            <tr><td class="px-4 py-3">32121</td><td class="px-4 py-3">Medical radiation technologists</td><td class="px-4 py-3">Confirm with employer</td></tr>
            <tr><td class="px-4 py-3">32122</td><td class="px-4 py-3">Medical sonographers</td><td class="px-4 py-3">Confirm with employer</td></tr>
            <tr><td class="px-4 py-3">32123</td><td class="px-4 py-3">Cardiology technologists and electrophysiological diagnostic technologists</td><td class="px-4 py-3">Confirm with employer</td></tr>
            <tr><td class="px-4 py-3">32200</td><td class="px-4 py-3">Traditional Chinese medicine practitioners and acupuncturists</td><td class="px-4 py-3">College of Complementary Health Professionals of BC</td></tr>
            <tr><td class="px-4 py-3">33101</td><td class="px-4 py-3">Medical laboratory assistants and related technical occupations</td><td class="px-4 py-3">Confirm with employer</td></tr>
          </tbody>
