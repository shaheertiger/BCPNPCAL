<ArticleLayout slug="bc-pnp-care-healthcare-occupations-list-2027" datePublished="2026-10-14" dateModified="2026-10-14" articleSection="Occupation Guide" keywords="BC PNP Care occupations, BC PNP healthcare NOC list, BC PNP health care draw, BC PNP 33102 health care assistant, BC PNP Health Authority stream, BC PNP ECE draw" title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <div class="inline-block bg-emerald-100 text-emerald-800 px-4 py-1 rounded-full text-sm font-bold mb-4 border border-emerald-200 shadow-sm">
