            <tr><td class="px-4 py-3">31200</td><td class="px-4 py-3">Psychologists</td><td class="px-4 py-3">CHCPBC</td></tr>
            <tr><td class="px-4 py-3">31201</td><td class="px-4 py-3">Chiropractors</td><td class="px-4 py-3">College of Complementary Health Professionals of BC</td></tr>
            <tr><td class="px-4 py-3">31202</td><td class="px-4 py-3">Physiotherapists</td><td class="px-4 py-3">CHCPBC</td></tr>
