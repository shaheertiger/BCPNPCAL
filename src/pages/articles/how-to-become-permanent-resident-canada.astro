---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "How to Become a Permanent Resident in Canada (2026): Every Way to Get Canadian PR";
const description = "How to become a permanent resident in Canada in 2026: Express Entry, PNPs, Quebec, AIP, family sponsorship, what is paused, plus the steps, costs and timelines.";
const canonical = "https://bcpnpcalculator.ca/articles/how-to-become-permanent-resident-canada";

const faqs = [
  {
    q: "How do I become a PR in Canada?",
    a: "You qualify under one permanent residence program, apply to IRCC, pass medical, criminal and security checks, and then land in Canada with your Confirmation of Permanent Residence. Most people qualify through Express Entry, a Provincial Nominee Program, Quebec's own selection, the Atlantic Immigration Program, a rural or francophone community pilot, or sponsorship by a Canadian spouse or partner."
  },
  {
    q: "How can I get Canadian PR without a job offer?",
    a: "Express Entry is the main option. The Federal Skilled Worker Program and Canadian Experience Class do not require a job offer, and IRCC also invites candidates by category, such as French-language proficiency. Some provincial Express Entry streams also select people without an offer. Most provincial worker streams, including the BC PNP, the Atlantic Immigration Program and the community pilots, do require one."
  },
  {
    q: "How can I apply for Canada permanent residence? Is there one application form?",
    a: "No. Each program has its own process. For Express Entry you create an online profile and can only apply after IRCC invites you. Provincial nominees apply either through Express Entry or, for base streams, through IRCC's Permanent Residence Portal. Quebec applicants need a Quebec Selection Certificate first, and family sponsorship starts with the sponsor's application."
  },
  {
    q: "How do I get PR from inside Canada as a temporary worker?",
    a: "The usual routes are the Canadian Experience Class (one year of skilled work in Canada within three years) and a Provincial Nominee Program stream for workers already employed in that province. The Atlantic Immigration Program and the rural and francophone pilots are also open to people already in Canada. If you are married to or living with a Canadian citizen or permanent resident, in-Canada spousal sponsorship is another route."
  },
  {
    q: "How long does it take to get permanent residence in Canada?",
    a: "IRCC's Express Entry service standard is to process most complete applications within six months of submission. Base provincial nominee and family applications usually take longer. Preparing language tests, credential assessments and documents, and waiting for an invitation or nomination, often adds several months to a year or more before you can apply."
  },
  {
    q: "How much does it cost to apply for Canadian permanent residency?",
    a: "For economic programs, IRCC charges $1,590 per adult (a $990 processing fee plus the $600 right of permanent residence fee) and $270 per dependent child, plus biometrics of $85 per person or $170 per family. Provinces may add their own fee, such as the BC PNP's $1,750 Skills Immigration application fee. Language tests, medicals, police certificates and translations cost extra."
  },
  {
    q: "Can I get Canada permanent residency through my spouse?",
    a: "Yes, if your spouse, common-law or conjugal partner is a Canadian citizen or permanent resident who is eligible to sponsor you. You can apply from outside Canada, or from inside Canada if you live together here. In-Canada applicants may be able to get an open work permit while they wait."
  },
  {
    q: "Is Canada still accepting PR applications from caregivers, parents or start-up founders?",
    a: "Not new ones, as of October 2026. IRCC lists the Home Care Worker Immigration Pilots as closed, the Parents and Grandparents Program is not accepting new interest to sponsor forms or inviting sponsors until further notice, and the Start-up Visa and Self-employed Persons programs are paused. IRCC continues to process applications it already received."
  },
  {
    q: "What is the difference between Canadian permanent residence and citizenship?",
    a: "A permanent resident can live, work and study anywhere in Canada and receives most social benefits, but cannot vote or run for office, cannot hold some jobs that need a high-level security clearance, and must spend at least 730 days in Canada in every five-year period to keep the status. Citizenship has no residency obligation and gives you a Canadian passport."
  },
  {
    q: "Does a provincial nomination guarantee permanent residence?",
    a: "No. A nomination is the province's selection decision; IRCC still decides your PR application and can refuse it for medical, criminal, security or misrepresentation reasons. An Express Entry nomination adds 600 CRS points, which in 2026 has been enough for an invitation in Provincial Nominee Program rounds."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
