            <tr class="border-t border-slate-200"><td class="p-3">Oct 22, 2026</td><td class="p-3">Completed post-secondary study in Manitoba</td><td class="p-3">734</td><td class="p-3 font-semibold">816</td></tr>
            <tr class="border-t border-slate-200"><td class="p-3">Sep 24, 2026</td><td class="p-3">BOC 2 natural and applied sciences</td><td class="p-3">417</td><td class="p-3 font-semibold">760</td></tr>
