            <tr class="border-t border-slate-200"><td class="p-3">Aug 27, 2026</td><td class="p-3">Major group 72 trades and transportation</td><td class="p-3">600</td><td class="p-3 font-semibold">731</td></tr>
            <tr class="border-t border-slate-200"><td class="p-3">Jul 30, 2026</td><td class="p-3">BOC 9 manufacturing and utilities</td><td class="p-3">605</td><td class="p-3 font-semibold">632</td></tr>
