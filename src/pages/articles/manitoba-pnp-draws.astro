---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Manitoba PNP Draws 2026: Latest MPNP EOI Draw Results, Scores and LAAs";
const description = "Manitoba PNP draws in 2026: recent MPNP EOI draws with LAAs and lowest scores, how the 1,000-point EOI ranking works, and what to do after you get an LAA.";
const canonical = "https://bcpnpcalculator.ca/articles/manitoba-pnp-draws";

const faqs = [
  {
    q: "When was the last Manitoba PNP draw?",
    a: "As of November 12, 2026, the most recent MPNP Expression of Interest draw was Draw #283 on November 5, 2026. It issued 526 Letters of Advice to Apply: 448 in an occupation-specific Skilled Worker in Manitoba selection for people working in Manitoba in broad occupational categories 8 and 9 (natural resources, agriculture and production; manufacturing and utilities), and 78 to Skilled Worker Stream candidates invited under a strategic recruitment initiative. No minimum score was published for either selection.",
  },
  {
    q: "What was the lowest score in recent Manitoba PNP draws?",
    a: "It depends on the selection. In Draw #282 on October 22, 2026, the lowest-ranked candidate invited scored 846 in the overall top-scoring Skilled Worker in Manitoba selection and 816 in the completed post-secondary study in Manitoba selection. Occupation-targeted selections have gone much lower: 632 for manufacturing and utilities workers on July 30, 2026, and 731 for major group 72 trades and transportation workers on August 27, 2026. Many selections, such as health care, teachers and strategic recruitment, publish no score at all.",
  },
  {
    q: "How often does Manitoba hold PNP draws?",
    a: "The MPNP does not publish a draw schedule. In practice, every EOI draw from Draw #274 on July 2, 2026 to Draw #283 on November 5, 2026 was held two weeks apart. That pattern can change at any time, so treat it as a description of the past rather than a forecast.",
  },
  {
    q: "What is the maximum MPNP EOI score?",
    a: "The MPNP EOI ranking grid adds up to 1,000 points: language up to 125, age up to 75, work experience up to 175, education up to 125 and adaptability up to 500. Risk factors can then subtract up to 200 points for work or study in another Canadian province. Ongoing employment in Manitoba for six months or more with a long-term job offer from the same employer, or an Invitation to Apply under a strategic initiative, is worth 500 adaptability points on its own.",
  },
  {
    q: "Do I need an Express Entry profile for a Manitoba PNP draw?",
    a: "Not for the 2026 draws covered here. Each draw notice reports how many Letters of Advice to Apply went to candidates who declared a valid Express Entry profile number and job seeker validation code (49 of 526 in Draw #283), but the selections themselves were open to eligible candidates with or without one. Declaring a valid Express Entry profile matters because it allows Manitoba to issue an enhanced nomination, which adds 600 Comprehensive Ranking System points to your federal profile.",
  },
  {
    q: "How long do I have to apply after a Manitoba LAA?",
    a: "The MPNP gives you 60 days from the date of your Letter of Advice to Apply to submit a full application in MPNP Online. The application fee is $500, non-refundable, and must be paid by Visa or Mastercard credit card (not Visa Debit). The MPNP says applications must be submitted using the Microsoft Edge browser.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
