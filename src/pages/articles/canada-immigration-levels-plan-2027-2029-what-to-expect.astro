---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Canada Immigration Levels Plan 2027–2029: What to Expect Before It Is Released";
const description = "The 2027–2029 Levels Plan is due this fall. See the 2027 targets already on paper, the TR cap problem, consultation themes, and what to watch for BC PNP.";
const canonical = "https://bcpnpcalculator.ca/articles/canada-immigration-levels-plan-2027-2029-what-to-expect";

const faqs = [
  {
    q: "Has the 2027–2029 Immigration Levels Plan been released?",
    a: "Not as of October 14, 2026. IRCC says the plan will be tabled in fall 2026. Section 94 of the Immigration and Refugee Protection Act requires the annual report to be tabled by November 1, or, if a House of Parliament is not sitting that day, within its next 30 sitting days. November 1, 2026 falls on a Sunday."
  },
  {
    q: "What is the 2027 permanent resident target right now?",
    a: "The 2026–2028 plan set a notional 2027 target of 380,000 permanent residents (range 350,000 to 420,000), including 244,700 economic immigrants and 92,500 Provincial Nominee Program admissions. IRCC says notional targets are confirmed or adjusted by November 1 each year, so the new plan may change them."
  },
  {
    q: "Will the PNP target go up or down in 2027?",
    a: "We do not know yet. The current notional 2027 PNP target is 92,500, up slightly from 91,500 in 2026, with a range of 82,000 to 106,000. The new plan will confirm or change it. Any forecast before tabling is speculation."
  },
  {
    q: "How does the Levels Plan affect my BC PNP chances?",
    a: "The plan sets the national PNP target. IRCC then gives each province an allocation. BC received 5,254 for 2026 in December 2025 and 1,000 more in August 2026, for a total of 6,254. BC's 2027 allocation will normally follow the new plan and has not been announced."
  },
  {
    q: "What is the temporary resident 5% target?",
    a: "The federal government has committed to reducing temporary residents to less than 5% of Canada's population by the end of 2027. Statistics Canada's preliminary estimate for July 1, 2026 was 2,779,774 non-permanent residents out of 41,798,407 people, or about 6.7%."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
