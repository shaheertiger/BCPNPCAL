<ArticleLayout slug="canadian-citizenship-certificate" datePublished="2026-11-14" dateModified="2026-11-14" articleSection="Guide" keywords="canadian citizenship certificate, citizenship certificate canada, proof of canadian citizenship, citizenship certificate application, cit 0001" ogImage="/images/articles/canadian-citizenship-certificate.png" title={title} description={description} canonical={canonical}>
