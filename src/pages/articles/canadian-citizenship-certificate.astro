---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Canadian Citizenship Certificate in 2026: How to Apply, Fee, Processing Time and Bill C-3";
const description = "Canadian citizenship certificate in 2026: who needs proof of citizenship, form CIT 0001, the $75 fee, IRCC's 34-month estimate, e-certificates and Bill C-3.";
const canonical = "https://bcpnpcalculator.ca/articles/canadian-citizenship-certificate";

const faqs = [
  {
    q: "What is a Canadian citizenship certificate?",
    a: "It is the document IRCC issues to confirm that a person is a Canadian citizen. It comes as a paper certificate or as an electronic certificate (e-certificate) that you download as a PDF. It proves citizenship, but it is not a passport or travel document. People born in Canada usually use their provincial or territorial birth certificate as proof instead.",
  },
  {
    q: "How much does a citizenship certificate cost in 2026?",
    a: "IRCC's fee list shows $75 per person for a citizenship certificate (proof of citizenship), checked on November 14, 2026. The same $75 applies to a search of citizenship records. Fees are paid online, and IRCC says they cannot be refunded once processing starts, or if the application is refused because the person is not a citizen.",
  },
  {
    q: "How long does it take to get a Canadian citizenship certificate?",
    a: "IRCC's processing-time tool estimates about 34 months for a new citizenship certificate application, with about 130,700 people waiting. That data was last updated on October 9, 2026, and we checked it on November 14, 2026. The estimate is for new applications and changes monthly, so check the tool before you apply.",
  },
  {
    q: "What form do I use to apply for proof of Canadian citizenship?",
    a: "The paper form is CIT 0001, Application for a Citizenship Certificate for Adults and Minors (Proof of Citizenship) Under Section 3, sent with the CIT 0014 document checklist. Many people can apply online instead, including those born outside Canada to a Canadian parent and people naturalized on or after April 17, 2009, if they were born on or after February 15, 1977.",
  },
  {
    q: "Did Bill C-3 change who can get a citizenship certificate?",
    a: "Yes. Bill C-3 took effect on December 15, 2025 and changed the first-generation limit on citizenship by descent. Most people born outside Canada before that date in the second or later generation to a Canadian parent are now automatically citizens. For children born abroad on or after December 15, 2025, the Canadian parent must have spent at least 1,095 days in Canada before the birth. IRCC recommends applying for a certificate to confirm your status.",
  },
  {
    q: "Can I travel with my citizenship certificate instead of a passport?",
    a: "Generally no. IRCC says proof of citizenship is not a passport or travel document. The exception is children 15 and under crossing the Canada-U.S. land or sea border, who can use a citizenship certificate, a birth certificate copy or a citizenship card if they have no passport. IRCC says a Canadian passport is the best document for flying to Canada as a Canadian.",
  },
  {
    q: "Is an e-certificate valid for a Canadian passport application?",
    a: "Yes. IRCC says the e-certificate is always valid proof of citizenship, but if you apply for a new adult passport you must print it, on letter-size paper, without photocopying or laminating it. The passport proof-of-citizenship page accepts a copy of a certificate whose number begins with K or X, or one issued on or after February 1, 2012.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
