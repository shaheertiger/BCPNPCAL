  <article class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <div class="inline-block bg-sky-100 text-sky-800 px-4 py-1 rounded-full text-sm font-bold mb-4 border border-sky-200 shadow-sm">
