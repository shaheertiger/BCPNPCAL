            <tr><td class="px-4 py-3">90–99</td><td class="px-4 py-3">1,444</td><td class="px-4 py-3">5,116</td></tr>
            <tr><td class="px-4 py-3">80–89</td><td class="px-4 py-3">1,281</td><td class="px-4 py-3">6,397</td></tr>
            <tr><td class="px-4 py-3">70–79</td><td class="px-4 py-3">718</td><td class="px-4 py-3">7,115</td></tr>
            <tr><td class="px-4 py-3">60–69</td><td class="px-4 py-3">364</td><td class="px-4 py-3">7,479</td></tr>
