const title = "BC PNP 2026 Draws Recap: Every Skills Immigration Draw and What It Signals for 2027";
const description = "Every 2026 BC PNP Skills Immigration draw in one place: dates, Care, Build and Innovate cutoffs, wage thresholds, pool data and practical lessons for 2027.";
const canonical = "https://bcpnpcalculator.ca/articles/bc-pnp-2026-draws-recap-2027-forecast";

const faqs = [
  {
    q: "How many BC PNP Skills Immigration invitations were issued in 2026?",
    a: "Adding up the draws published on WelcomeBC's invitations page from February 4 to October 8, 2026 gives at least 6,297 Skills Immigration invitations, plus four categories reported only as fewer than five. Invitations are not nominations, and Health Authority stream applications do not need an invitation, so this is not a count of nominations."
  },
  {
    q: "What was the lowest BC PNP cutoff score in 2026?",
    a: "Among Skills Immigration categories, the lowest published minimum score was 50 points in the July 23, 2026 Temporary Rural/Remote Health Support Initiative draw. In the regular priority draws, Care: Health fell to 76 points on September 10 and October 8, 2026, and Care: Education was 68 on August 6, 2026."
  },
  {
    q: "What wage did the BC PNP High Economic Impact draws require in 2026?",
    a: "The wage-based High Economic Impact track required both an hourly and an annual minimum plus a NOC TEER 0 to 3 job offer. It started at $70 per hour and $145,000 per year on February 4, 2026 and fell to $52 per hour and $105,000 per year on September 24, 2026."
  },
  {
    q: "Will BC PNP cutoffs go down in 2027?",
    a: "Nobody can know yet. The 2027 allocation has not been announced. Based on 2025 and 2026 patterns, we expect a slow start to the year and cutoffs that open higher before easing as the year's allocation is confirmed and used. Treat any exact 2027 cutoff prediction with suspicion."
  },
  {
    q: "Do Care and Build draws still use the points score?",
    a: "Yes. Care and Build draws first restrict the pool to eligible priority occupations and conditions, such as an ECE certificate or a SkilledTradesBC credential, and then invite the highest-scoring registrants in that group. That is why the Care: Health cutoff can be far lower than the points cutoff in Innovate draws."
  },
  {
    q: "How big was the BC PNP registration pool in October 2026?",
    a: "WelcomeBC reported 7,695 registrations in the Skills Immigration pool as of October 6, 2026. Only 203 of them scored 130 or higher, while the largest groups were in the 90 to 99 range (1,444) and the 100 to 109 range (1,426)."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
