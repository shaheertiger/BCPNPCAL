<ArticleLayout slug="canada-visitor-visa-processing-time" datePublished="2026-11-13" dateModified="2026-11-13" articleSection="Guide" keywords="visitor visa processing time, trv, temporary resident visa, imm5257, canada visitor visa processing time, visitor visa canada processing time" ogImage="/images/articles/canada-visitor-visa-processing-time.png" title={title} description={description} canonical={canonical}>
