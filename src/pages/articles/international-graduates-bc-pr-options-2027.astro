---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "International Graduates in BC: PR Options for 2027 Now That Student Streams Are Gone";
const description = "BC PNP will not launch new student streams. What BC grads can still use: Skills Immigration with education points, CEC, PGWP timing rules and other provinces.";
const canonical = "https://bcpnpcalculator.ca/articles/international-graduates-bc-pr-options-2027";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does the BC PNP still have a stream for international graduates?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. On April 23, 2026 the BC PNP said it will not be launching new student streams and that international graduates may wish to explore existing BC PNP streams. The current Skills Immigration streams are the Skilled Worker and Health Authority streams. Completing studies in B.C. or Canada still earns extra registration points."
      }
    },
    {
      "@type": "Question",
      "name": "How many BC PNP points do I get for studying in B.C.?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You get points for your highest level of education plus 8 additional points if that credential was completed at a post-secondary institution in B.C., or 6 if completed elsewhere in Canada. Graduates of a public B.C. institution outside Metro Vancouver can also earn 10 regional alumni points if they register within three years of graduating and their job offer is outside Metro Vancouver."
      }
    },
    {
      "@type": "Question",
      "name": "Does work during my studies count for the BC PNP or CEC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generally no. The BC PNP does not accept work experience gained while on a study permit, except paid, full-time co-op terms in a skilled occupation after you have completed your program. For the federal Canadian Experience Class, work while studying full-time and co-op terms do not count."
      }
    },
    {
      "@type": "Question",
      "name": "Can I extend my Post-Graduation Work Permit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not in the usual sense. IRCC says you cannot get a PGWP if you already received one after an earlier program. The only extension IRCC describes is when your passport expired before the full PGWP period, in which case you can apply on paper after getting a new passport."
      }
    },
    {
      "@type": "Question",
      "name": "What is the fastest PR route for a recent BC graduate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on your profile. Graduates in a BC PNP Care or Build occupation can be invited at much lower scores than other candidates. High earners can use the BC PNP High Economic Impact wage lane. Others usually rely on the Canadian Experience Class after 12 months of skilled work, which had 2026 cutoffs between 507 and 523, or the French category if they have NCLC 7 French."
      }
    }
  ]
};
