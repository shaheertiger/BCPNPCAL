              <th class="px-4 py-3 text-left font-bold text-slate-700">Wage lane ITAs</th>
              <th class="px-4 py-3 text-left font-bold text-slate-700">Points lane cutoff</th>
              <th class="px-4 py-3 text-left font-bold text-slate-700">Points lane ITAs</th>
            </tr>
          </thead>
