---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { calculateTotalPoints } from "../../utils/calculatePoints";
import { BLANK } from "../../data/example-profiles";
import { latestFor } from "../../utils/draws";
import { LINKS } from "../../data/site-links";

const title = "BC PNP Work Experience Requirements 2026: 2 Years, Which Jobs Count";
const description =
  "Skilled Worker needs 2 years of full-time skilled (TEER 0–3) work from the last 10 years. Directly related experience then earns up to 40 SIRS points.";

const GUIDE = "https://www.welcomebc.ca/immigrate-to-b-c/bc-pnp-si-program-guide-pdf";
const SKILLS = "https://www.welcomebc.ca/immigrate-to-b-c/skills-immigration";

// Worked example: a cook (NOC 63200, TEER 3) scored by the site's calculator.
// The wage is an example offer, not wage data.
const cookState = {
  ...BLANK,
  experience: "2" as const,
  hasCanadianExp: true,
  hasCurrentBCJob: true,
  education: "trades_cert" as const,
  hasEnglishTest: true,
  englishClb: 5 as const,
  hourlyWage: 22,
  area: "area3" as const,
};
const cook = calculateTotalPoints(cookState);
const cook5 = calculateTotalPoints({ ...cookState, experience: "5+" });
const cookExp = cook.breakdown.experience + cook.breakdown.canadianExp + cook.breakdown.currentBCJob;
const cook5Exp = cook5.breakdown.experience + cook5.breakdown.canadianExp + cook5.breakdown.currentBCJob;
const hei = latestFor("hei-points");

const faqs = [
  {
    q: "Does work experience outside Canada count for BC PNP?",
    a: "Yes. The two years of skilled experience the Skilled Worker stream requires can be from Canada or abroad, as long as it was gained in the last 10 years. Foreign experience also earns directly related experience points, but only experience in Canada earns the extra 10 points for one year in Canada.",
  },
  {
    q: "Do my 2 years have to be in the same job as my B.C. job offer?",
    a: "No. The 2-year minimum can be in any skilled occupation (NOC TEER 0, 1, 2 or 3). Only experience in the same NOC as your job offer, or a closely related one at the same or a higher TEER, earns directly related experience points.",
  },
  {
    q: "Does unpaid or volunteer work count?",
    a: "No. The BC PNP only counts work for which you received wages. The one exception is research or coursework during a doctoral degree from a Canadian public university, or a doctorate held by someone with a university professor offer at a B.C. public university.",
  },
  {
    q: "Does parental or medical leave count toward work experience?",
    a: "No. Time on a leave of absence or extended leave is not counted, even if you stayed employed. Reasonable vacation periods are not deducted.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};

const h2 = "text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-12 mb-4";
const p = "text-slate-700 text-base sm:text-lg leading-relaxed mb-4";
const a = "text-red-600 font-semibold underline underline-offset-2 hover:text-red-700";
const src = "underline underline-offset-2 hover:text-red-600";
---

<ArticleLayout
  slug="bc-pnp-work-experience-requirements-2026"
  datePublished="2026-02-09"
  dateModified="2026-11-26"
  articleSection="Eligibility"
  breadcrumbLabel="Work Experience Requirements"
  keywords="BC PNP work experience requirements, how much experience required for BC PNP, directly related work experience BC PNP, lowest work experience PNP 2026"
  title={title}
  description={description}
  jsonLd={jsonLd}
  related={["jobOffer", "caregivers", "tech", "ece"]}
  canonical="https://bcpnpcalculator.ca/articles/bc-pnp-work-experience-requirements-2026"
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <header class="mb-6">
      <p class="text-sm font-bold text-red-600 uppercase tracking-widest mb-3">Eligibility · Updated November 26, 2026</p>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        How much work experience do you need for BC PNP?
      </h1>
    </header>

    <p class={p}>
      You need at least 2 years of full-time (or full-time equivalent) work experience in a skilled NOC TEER 0, 1, 2 or 3 occupation, gained in Canada or abroad within the last 10 years, to qualify for the BC PNP Skilled Worker stream. That minimum gets you in the door; your score then depends on how much of your experience is directly related to your B.C. job offer, which is worth up to 40 of the 200 points in our <a href={LINKS.calculator.href} class={a}>{LINKS.calculator.short}</a>.
    </p>

    <aside class="rounded-2xl border border-red-100 bg-red-50/60 p-5 sm:p-6 my-8" aria-label="Key facts">
      <p class="font-black text-slate-900 mb-3">Key facts</p>
      <ul class="space-y-2 text-slate-700 text-sm sm:text-base list-disc pl-5">
        <li><strong>Skilled Worker:</strong> 2 years of full-time or equivalent skilled (TEER 0–3) experience from the last 10 years (Program Guide 4.1(c)).</li>
        <li><strong>Health Authority:</strong> the experience your B.C. health authority employer requires for the job (4.2(f)).</li>
        <li><strong>Points:</strong> directly related experience earns up to 20 points, plus 10 for a year in Canada and 10 for working for your B.C. employer now (8.1).</li>
        <li><strong>Part-time</strong> work counts at 50% for points; full-time means at least 30 hours a week.</li>
        <li><strong>Not counted:</strong> unpaid work and work done on a study permit (paid co-op terms can qualify).</li>
      </ul>
    </aside>

    <h2 class={h2}>How much experience is required for BC PNP?</h2>
    <p class={p}>
      It depends on the stream. The <a href={SKILLS} target="_blank" rel="noopener noreferrer" class={src}>WelcomeBC Skills Immigration page</a> lists two streams. The Skilled Worker stream requires a minimum of two years of full-time or full-time equivalent experience in any skilled occupation. It does not have to be the same occupation as your job offer. The Health Authority stream has no fixed number: you must meet the education, training and experience your public health authority employer requires.
    </p>
    <p class={p}>
      This minimum is separate from the directly related experience scored at registration: 2 years in another skilled job meets the rule but can score 0 experience points.
    </p>

    <h2 class={h2}>How many points does BC PNP work experience give?</h2>
    <div class="overflow-x-auto rounded-2xl border border-slate-200 my-6">
      <table class="w-full text-sm sm:text-base text-left">
        <caption class="sr-only">BC PNP points for directly related work experience</caption>
        <thead class="bg-slate-100 text-slate-900">
          <tr><th scope="col" class="px-4 py-3 font-bold">Directly related experience in the job offer's occupation</th><th scope="col" class="px-4 py-3 font-bold text-right">Points</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          <tr><td class="px-4 py-2.5">5 or more years</td><td class="px-4 py-2.5 text-right font-bold">20</td></tr>
          <tr><td class="px-4 py-2.5">At least 4 but less than 5 years</td><td class="px-4 py-2.5 text-right font-bold">16</td></tr>
          <tr><td class="px-4 py-2.5">At least 3 but less than 4 years</td><td class="px-4 py-2.5 text-right font-bold">12</td></tr>
          <tr><td class="px-4 py-2.5">At least 2 but less than 3 years</td><td class="px-4 py-2.5 text-right font-bold">8</td></tr>
          <tr><td class="px-4 py-2.5">At least 1 but less than 2 years</td><td class="px-4 py-2.5 text-right font-bold">4</td></tr>
          <tr><td class="px-4 py-2.5">Less than 1 year</td><td class="px-4 py-2.5 text-right font-bold">1</td></tr>
          <tr><td class="px-4 py-2.5">No experience</td><td class="px-4 py-2.5 text-right font-bold">0</td></tr>
          <tr class="bg-red-50/60"><td class="px-4 py-2.5">Additional: at least 1 year of directly related experience in Canada</td><td class="px-4 py-2.5 text-right font-bold">10</td></tr>
          <tr class="bg-red-50/60"><td class="px-4 py-2.5">Additional: currently working full-time in B.C. for the supporting employer, same occupation</td><td class="px-4 py-2.5 text-right font-bold">10</td></tr>
          <tr class="bg-slate-900 text-white"><th scope="row" class="px-4 py-2.5 text-left font-black">Maximum</th><td class="px-4 py-2.5 text-right font-black">40</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-slate-500 -mt-3 mb-6">Source: section 8.1, <a href={GUIDE} target="_blank" rel="noopener noreferrer" class={src}>BC PNP Skills Immigration Program Guide</a> (effective June 10, 2026).</p>

    <h2 class={h2}>What counts as directly related work experience?</h2>
    <p class={p}>
      Paid work classified under the same NOC code as your B.C. job offer. Experience in a related occupation at the same or a higher TEER can also count if you can show how it is directly related; for a TEER 0 offer, related TEER 1 experience may be considered. It must be from the last 10 years.
    </p>

    <h2 class={h2}>Does part-time work count?</h2>
    <p class={p}>
      Yes, at half value. For directly related experience points, part-time work is credited at 50% of its duration. For the 10 extra points for experience in Canada, you need 12 months if you worked 30 or more regular hours a week, or 24 months if you worked fewer. Full-time means a minimum of 30 regular hours a week.
    </p>

    <h2 class={h2}>Does co-op or student work count?</h2>
    <p class={p}>
      Work done on a study permit is not accepted, for the minimum or for points. Paid co-op terms are the exception, if you finished your program, the co-op was full-time (30+ hours a week) and it was in a skilled occupation. Unpaid doctoral research can count only for graduates of a Canadian public university or doctorate holders with a professor offer at a B.C. public university (section 3.8).
    </p>

    <h2 class={h2}>What is the lowest work experience for PNP in 2026?</h2>
    <p class={p}>
      Within the BC PNP, 2 years for the Skilled Worker stream. The Temporary Rural/Remote Health Support Initiative asked for only nine consecutive months with the same health authority, but it covered three cleaning and security occupations and its registration closed on October 7, 2026. The Entry Level and Semi-Skilled stream is no longer offered: the June 10, 2026 Program Guide lists only the Skilled Worker and Health Authority streams.
    </p>

    <h2 class={h2}>How many points does a cook with 2 years in B.C. get?</h2>
    <p class={p}>
      Take a cook (NOC 63200, TEER 3) in Kamloops with 2 years of experience, all of it in B.C. with the current employer, a post-secondary certificate from abroad, CLB 5 and an example offer of $22.00 an hour. Our calculator gives {cookExp} of 40 work experience points and a total SIRS score of <strong>{cook.total}</strong>. With 5 or more years in the same job, experience rises to {cook5Exp} and the total to {cook5.total}.
    </p>
    <p class={p}>
      Cooks are not on a Care or Build priority list, so they compete in High Economic Impact draws, whose latest points minimum was {hei.score} on {hei.date}. Experience alone rarely closes that gap; wage and location carry 80 points (see the <a href={LINKS.draws.href} class={a}>{LINKS.draws.short}</a>). Our guide to <a href={LINKS.jobOffer.href} class={a}>{LINKS.jobOffer.short}</a> covers the offer side.
    </p>

    <h2 class={h2}>Common mistakes</h2>
    <ul class="list-disc pl-6 space-y-2 text-slate-700 text-base sm:text-lg mb-4">
      <li>Counting experience older than 10 years, or work done on a study permit.</li>
      <li>Claiming full points for part-time work instead of 50%.</li>
      <li>Matching job titles instead of NOC duties: points need the same NOC as the offer.</li>
      <li>Claiming the "currently working" 10 points when the offer is a future promotion.</li>
      <li>Including parental or medical leave in your total.</li>
    </ul>

    <h2 class={h2}>Frequently asked questions</h2>
    <div class="space-y-4">
      {faqs.map((f) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-900 mb-2">{f.q}</h3>
          <p class="text-slate-700 leading-relaxed">{f.a}</p>
        </div>
      ))}
    </div>

    <p class="text-xs text-slate-500 mt-8">
      Sources: <a href={GUIDE} target="_blank" rel="noopener noreferrer" class={src}>Skills Immigration Program Guide</a> sections 3.8, 4.1, 4.2, 4.3 and 8.1 (effective June 10, 2026); <a href={SKILLS} target="_blank" rel="noopener noreferrer" class={src}>WelcomeBC Skills Immigration</a>. General information, not legal advice.
    </p>
  </article>
</ArticleLayout>
