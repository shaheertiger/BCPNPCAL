<ArticleLayout slug="new-brunswick-pnp-guide" datePublished="2026-11-16" dateModified="2026-11-16" articleSection="Guide" keywords="new brunswick pnp, new brunswick canada pnp, pnp nb canada, nb pnp, pnp nb, pnp new brunswick, nb pnp draw" ogImage="/images/articles/new-brunswick-pnp-guide.png" title={title} description={description} canonical={canonical}>
