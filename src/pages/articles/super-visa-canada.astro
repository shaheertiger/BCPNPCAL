---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Super Visa Canada 2026: Requirements, Income Table, Insurance and Fees for Parents and Grandparents";
const description = "Super visa Canada 2026: who qualifies, 5-year stays, the host's minimum income table, $100,000 insurance rule, fees, processing times and refusal reasons.";
const canonical = "https://bcpnpcalculator.ca/articles/super-visa-canada";

const faqs = [
  {
    q: "How long can parents stay in Canada on a super visa?",
    a: "Up to 5 years at a time. For anyone who applied on or after June 22, 2023, IRCC says super visa holders are eligible to stay for 5 years per entry, and the visa itself allows multiple entries for up to 10 years (IRCC says it cannot be valid longer than your biometrics). You can apply to extend from inside Canada before your status runs out; the fee to extend a visitor stay is $100 per person as of November 2026.",
  },
  {
    q: "What is the super visa income requirement in 2026?",
    a: "The host child or grandchild, plus a co-signing spouse if needed, must meet IRCC's minimum necessary income for the family size. The table IRCC currently publishes (updated July 29, 2025) starts at $30,526 for one person, $38,002 for two, $46,720 for three and $56,724 for four. Since March 31, 2026 the host can meet it in either of the two tax years before applying, or reach at least 75% of it in the previous year and top up the rest with the visiting parent's own income.",
  },
  {
    q: "What insurance do I need for a super visa?",
    a: "Private medical insurance from a Canadian insurer, or a foreign insurer authorized by OSFI that issued the policy while doing insurance business in Canada. It must cover health care, hospitalization and repatriation, provide at least $100,000 in emergency coverage, be valid for at least one year from each entry, and be paid in full or in instalments with a deposit. Quotes are not accepted.",
  },
  {
    q: "How much does a super visa cost?",
    a: "IRCC's fee is $100 per person, plus $85 for biometrics if you need to give them (the biometrics fee is capped at $170 for a family applying together). Visa-exempt applicants do not pay the $100 visa fee. On top of that you pay the panel physician for the medical exam and buy the insurance policy, which is usually the biggest cost.",
  },
  {
    q: "How long does super visa processing take?",
    a: "It depends on the country you apply from. IRCC's processing-time tool, last updated November 4, 2026, showed 85 days for applicants in India, 89 days in China, 101 days in Pakistan, 104 days in the United Kingdom and 109 days in the Philippines. Biometrics are not included in those estimates.",
  },
  {
    q: "Can I sponsor my parents for permanent residence instead?",
    a: "Not right now through a new application. IRCC's Parents and Grandparents Program page says it is not accepting applications or new interest to sponsor forms until further notice, while it keeps processing existing files. The super visa is the main long-stay option while the PGP is paused, and you can hold a super visa while a sponsorship you already filed is in process.",
  },
  {
    q: "Can a parent bring dependent children on a super visa?",
    a: "No. The super visa is only for parents and grandparents of the host, and dependants cannot be included. Each parent or grandparent applies in their own name, although both members of a couple can apply at the same time and be counted in the same family size.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
