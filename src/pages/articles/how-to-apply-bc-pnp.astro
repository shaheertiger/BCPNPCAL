---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { calculateTotalPoints } from "../../utils/calculatePoints";
import { BLANK } from "../../data/example-profiles";
import { LINKS } from "../../data/site-links";
import { latestFor, latestDrawDate } from "../../utils/draws";

const title = "How to Apply for BC PNP in 2026: 6 Steps (Register → ITA → Apply)";
const description =
  "Register free, wait for an invitation, then submit your application and the $1,750 fee within 30 days. WelcomeBC processes most in about 3 months.";

const WELCOMEBC_SI = "https://www.welcomebc.ca/immigrate-to-b-c/skills-immigration";
const GUIDE = "https://www.welcomebc.ca/immigrate-to-b-c/bc-pnp-si-program-guide-pdf";
const ITA_PAGE = "https://www.welcomebc.ca/immigrate-to-b-c/about-the-bc-provincial-nominee-program/invitations-to-apply";

// Worked example: a cook (NOC 63200, TEER 3) in Kamloops, scored by the
// site's calculator engine. The wage is an example offer, not wage data.
const cookWage = 20;
const cook = calculateTotalPoints({
  ...BLANK,
  experience: "2",
  hasCanadianExp: true,
  hasCurrentBCJob: true,
  education: "trades_cert",
  hasEnglishTest: true,
  englishClb: 5,
  hourlyWage: cookWage,
  area: "area3",
  hasWorkedOutsideArea1: true,
});
const cb = cook.breakdown;
const cookExp = cb.experience + cb.canadianExp + cb.currentBCJob;
const cookArea = cb.area + cb.regionalBonus;
const hei = latestFor("hei-points");
const heiScore = hei.score as number;
const gap = heiScore - cook.total;

const steps = [
  { n: 1, name: "Choose your stream", what: "Skilled Worker (job offer in an eligible TEER 0–3 occupation, 2 years of skilled work experience) or Health Authority (job offer from a B.C. public health authority).", fee: "—", time: "—" },
  { n: 2, name: "Register online", what: "Create a BCPNP Online profile and submit a registration. It is scored out of 200. Health Authority applicants skip this step and apply directly.", fee: "No fee", time: "Stays in the pool up to 12 months" },
  { n: 3, name: "Wait for an invitation to apply (ITA)", what: "The BC PNP invites candidates from the pool in draws, by score and by selection factors such as occupation.", fee: "—", time: "No fixed wait" },
  { n: 4, name: "Submit your BC PNP application", what: "Upload all documents, including the signed Employer Declaration Form, in BCPNP Online.", fee: "$1,750", time: "Within 30 calendar days of the ITA (cannot be extended)" },
  { n: 5, name: "Wait for the nomination decision", what: "If approved, you receive a Confirmation of Nomination. A refusal can be reviewed once.", fee: "$500 for a request for review", time: "About 3 months (WelcomeBC posted time)" },
  { n: 6, name: "Submit your IRCC application", what: "Apply to IRCC for permanent residence before your nomination expires. EEBC nominees apply through Express Entry.", fee: "IRCC fees", time: "Set by IRCC" },
];

const faqs = [
  {
    q: "How long does it take to apply for BC PNP?",
    a: "There is no fixed wait between registering and being invited. After an invitation you have 30 calendar days to submit your application, and WelcomeBC's posted processing time for applications is about 3 months.",
  },
  {
    q: "How much does it cost to apply for BC PNP?",
    a: "Registering is free. The Skills Immigration application fee is $1,750, and a request for review costs $500. IRCC charges its own fees for the permanent residence application.",
  },
  {
    q: "How long does a BC PNP registration stay valid?",
    a: "Up to 12 months. If you are not invited within 12 months, the registration is removed from the pool and you can register again. A registration is also removed once you receive an invitation, even if you do not apply.",
  },
  {
    q: "Do I need an Express Entry profile to apply for BC PNP?",
    a: "No. Express Entry BC (EEBC) is an option for the Skilled Worker and Health Authority streams. To use it you need a valid IRCC Express Entry Profile Number and Job Seeker Validation Code, and a TEER 0–3 job offer.",
  },
  {
    q: "Can I apply for BC PNP without a job offer?",
    a: "No. Both Skills Immigration streams require a full-time, indeterminate job offer from an eligible B.C. employer, and the employer must support you before you register.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to apply for the BC PNP (Skills Immigration)",
    description,
    step: steps.map((s) => ({ "@type": "HowToStep", position: s.n, name: s.name, text: s.what })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const a = "text-red-600 font-semibold underline underline-offset-2 hover:text-red-700";
const ext = "text-red-600 underline underline-offset-2 hover:text-red-700";
const h2 = "text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-12 mb-4";
const p = "text-slate-700 leading-relaxed mb-4";
---

<ArticleLayout
  slug="how-to-apply-bc-pnp"
  datePublished="2026-01-29"
  dateModified="2026-11-26"
  keywords="how to apply for BC PNP, BC PNP application process, BC PNP registration, BC PNP invitation to apply"
  title={title}
  description={description}
  jsonLd={jsonLd}
  related={["jobOffer", "fees", "workExperience", "withoutJobOffer"]}
>
  <article class="bg-slate-50 py-10 sm:py-14 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <header class="mb-8">
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          How do you apply for BC PNP?
        </h1>
        <p class="mt-4 text-lg text-slate-700 leading-relaxed">
          You apply for the BC PNP in 6 steps: choose a stream, register online for free, wait for an invitation to apply, submit your application and the $1,750 fee within 30 days, wait about 3 months for a decision, then apply to IRCC for permanent residence.
        </p>
      </header>

      <aside class="rounded-2xl border border-red-100 bg-white p-6 mb-10" aria-label="Key facts">
        <p class="text-xs font-black uppercase tracking-widest text-red-600 mb-3">Key facts</p>
        <ul class="space-y-2 text-slate-800 text-sm sm:text-base">
          <li><strong>Streams:</strong> Skilled Worker and Health Authority, each with an Express Entry BC option.</li>
          <li><strong>Job offer:</strong> full-time (30+ hours a week on average) and indeterminate, from an employer who supports you before you register.</li>
          <li><strong>Fees:</strong> registration free, application $1,750, request for review $500.</li>
          <li><strong>Deadlines:</strong> registration lasts up to 12 months; after an invitation you have 30 calendar days to apply.</li>
        </ul>
      </aside>

      <h2 class={h2}>How do I apply for BC PNP? The 6 steps</h2>
      <p class={p}>
        These are the steps WelcomeBC lists on its <a href={WELCOMEBC_SI} target="_blank" rel="noopener noreferrer" class={ext}>Skills Immigration page</a>, with the fees and time limits from the same page and the <a href={GUIDE} target="_blank" rel="noopener noreferrer" class={ext}>Skills Immigration Program Guide</a> (effective June 10, 2026).
      </p>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 mb-3">
        <table class="w-full text-sm text-left bg-white">
          <caption class="sr-only">BC PNP application steps, fees and time limits</caption>
          <thead class="bg-slate-100 text-slate-900">
            <tr>
              <th scope="col" class="px-3 py-2.5 font-bold">Step</th>
              <th scope="col" class="px-3 py-2.5 font-bold">What you do</th>
              <th scope="col" class="px-3 py-2.5 font-bold">Fee</th>
              <th scope="col" class="px-3 py-2.5 font-bold">Time limit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {steps.map((s) => (
              <tr>
                <th scope="row" class="px-3 py-2.5 font-black text-slate-900 align-top whitespace-nowrap">{s.n}. {s.name}</th>
                <td class="px-3 py-2.5 text-slate-700 align-top">{s.what}</td>
                <td class="px-3 py-2.5 text-slate-700 align-top whitespace-nowrap">{s.fee}</td>
                <td class="px-3 py-2.5 text-slate-700 align-top">{s.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 mb-6">
        Sources: <a href={WELCOMEBC_SI} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC, Skills Immigration</a> (fees, steps, processing time); Program Guide sections 4.2, 7.1, 7.3 and 7.7.
      </p>

      <h2 class={h2}>What do I need before I register for BC PNP?</h2>
      <p class={p}>
        You need a job offer that meets the <a href={LINKS.jobOffer.href} class={a}>{LINKS.jobOffer.short}</a>: one regular full-time position, averaging at least 30 hours a week year-round, with no end date, from an eligible B.C. employer (Program Guide 3.5). The employer must agree to support you before you register and will sign an Employer Declaration Form (3.6). Some occupations are excluded outright, such as administrative assistants (NOC 13110) and retail sales supervisors (62010) (3.11).
      </p>
      <p class={p}>
        For a TEER 2–5 job offer you also need valid language results at CLB 4 or higher in all four skills; for TEER 0 or 1 a test is optional unless you claim points for it (3.4). Tests are valid for two years and must still be valid when you register to earn points.
      </p>

      <h2 class={h2}>How is the BC PNP registration scored?</h2>
      <p class={p}>
        Your registration gets a score out of 200 from five factors: directly related work experience (40), education (40), language (40), the hourly wage of your job offer (55) and the area of B.C. where you will work (25) (Program Guide Part 8). Draws invite the highest-scoring candidates in each selection group, so this number decides when, or whether, you are invited. You can work it out in two minutes with the <a href={LINKS.calculator.href} class={a}>{LINKS.calculator.short}</a>.
      </p>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 my-6" id="worked-example">
        <p class="text-xs font-black uppercase tracking-widest text-slate-500 mb-2">Worked example</p>
        <p class="text-slate-800 leading-relaxed">
          A cook (NOC 63200) in Kamloops with 2 years of experience in B.C., currently working for the employer, a post-secondary diploma from outside Canada, CLB 5 and a full-time example offer of ${cookWage.toFixed(2)}/hr scores <strong>{cook.total}</strong>: {cookExp} for experience, {cb.educationTotal} for education, {cb.languageTotal} for language, {cb.wage} for wage and {cookArea} for working in Area 3 with a year of regional experience.
        </p>
        <p class="text-slate-700 leading-relaxed mt-3">
          Cooks are not in the Care or Build occupation groups, so the comparison is the High Economic Impact points draw, which needed {heiScore} on {hei.date}. That is {gap} points away, and the gap shows why the registration score matters more than the paperwork.
        </p>
      </div>

      <h2 class={h2}>What happens after the invitation to apply?</h2>
      <p class={p}>
        Invitations go out in draws. The most recent Skills Immigration draw was on {latestDrawDate}; the <a href={LINKS.draws.href} class={a}>{LINKS.draws.short}</a> show every 2026 minimum by stream, taken from the <a href={ITA_PAGE} target="_blank" rel="noopener noreferrer" class={ext}>WelcomeBC invitations page</a>. Once invited, your registration leaves the pool and you have 30 calendar days to submit a complete application. The deadline cannot be extended (Program Guide 7.3). Everything in the application is checked against the registration: if your NOC, work location or score no longer matches what got you invited, the application can be refused (7.1).
      </p>
      <p class={p}>
        If anything changes after you apply, such as your employer, job title, wage or hours, you must tell the BC PNP within 15 calendar days (7.4). After nomination, you apply to IRCC for permanent residence before the nomination expires. If you used the Express Entry BC option, the nomination adds CRS points to your Express Entry profile and your PR application is processed through Express Entry (Part 5).
      </p>

      <h2 class={h2}>How much does it cost to apply for BC PNP?</h2>
      <p class={p}>
        Registering costs nothing. The application fee is $1,750, paid only through BCPNP Online, and it is refunded only if you withdraw before assessment starts. A request for review of a refusal costs $500 and is non-refundable; it must be filed within 30 days of the decision if you live in Canada, or 60 days if you live outside Canada (7.7). Language tests, credential assessments and IRCC fees come on top. See <a href={LINKS.fees.href} class={a}>{LINKS.fees.short}</a> for the full budget.
      </p>

      <h2 class={h2}>Common mistakes</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-700 leading-relaxed mb-6">
        <li><strong>Registering before the employer agrees.</strong> Employer support is required before you register, not after you are invited.</li>
        <li><strong>Registration details that differ from the application.</strong> A different NOC or work location, or a lower score that falls below the draw minimum, can lead to a refusal.</li>
        <li><strong>Counting bonuses or overtime in the wage.</strong> Only the hourly rate counts; tips, commissions, overtime and allowances are excluded (3.9).</li>
        <li><strong>Letting a language test expire.</strong> Results are valid for two years from issue.</li>
        <li><strong>Missing the 30-day window.</strong> An expired invitation also removes your registration from the pool.</li>
      </ul>

      <h2 class={h2}>FAQ: applying for BC PNP</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="font-black text-slate-900 mb-2">{f.q}</h3>
            <p class="text-slate-700 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>

      <p class="text-xs text-slate-500 mt-8">
        General information based on WelcomeBC and the BC PNP Skills Immigration Program Guide (effective June 10, 2026). It is not legal advice.
      </p>
    </div>
  </article>
</ArticleLayout>
