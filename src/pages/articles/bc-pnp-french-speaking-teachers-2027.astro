const description = "French-speaking K-12 teachers are a BC PNP priority. Learn the certification steps, the CLB 5 French rule, Francophone Mobility permits and the 2027 outlook.";
const canonical = "https://bcpnpcalculator.ca/articles/bc-pnp-french-speaking-teachers-2027";

const faqs = [
  {
    q: "Who qualifies for the BC PNP's targeted Education invitations?",
    a: "WelcomeBC's selection list says French-speaking secondary teachers (NOC 41220) and elementary and kindergarten teachers (NOC 41221) must be employed in B.C.'s public K-12 system and have CLB 5 or higher in French to receive a targeted invitation. They must also meet the normal Skilled Worker stream requirements."
  },
  {
    q: "Which French test does the BC PNP accept?",
    a: "The BC PNP accepts only TEF Canada and TCF Canada for French. Diplomas such as the DELF or DALF can help you meet B.C.'s teacher certification language standard, but they are not accepted as BC PNP language test results."
  },
  {
    q: "How do I get certified to teach in B.C. if I trained abroad?",
    a: "You apply online for a Certificate of Qualification (the fee is $245), have official transcripts sent directly to the Ministry of Education and Child Care, and provide a Statement of Professional Standing from every jurisdiction where you have been certified. If your teacher education was outside Canada, you must complete a familiarization course approved by the BC Teachers' Council, and you may be asked for a Pathways to Teach Canada credential assessment."
  },
  {
    q: "Can a temporary teaching contract qualify for the BC PNP?",
    a: "Yes, in some cases. The program guide's Appendix A lets teachers in NOC 41220 and 41221 use a limited-term job offer if it is from a public K-12 school in B.C., lasts at least one year, and has at least 120 days remaining when you apply. Most other occupations need an indeterminate job offer."
  },
  {
    q: "What is the Francophone Mobility work permit?",
    a: "It is an LMIA-exempt work permit for French speakers with a job offer outside Quebec. For applications made on or after June 15, 2023, you must show intermediate French speaking and listening skills, equivalent to NCLC 5 or higher. The employer submits the offer under exemption code C16 and pays a $230 employer compliance fee."
  },
  {
    q: "How competitive are BC PNP Education draws?",
    a: "Not very, so far. The only Education draw shown on WelcomeBC in 2026 was on August 6, 2026, with a minimum score of 68 and fewer than five invitations. The challenge for teachers is meeting certification and job requirements, not reaching a high score."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
