---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Express Entry Draws 2026: Latest Rounds, CRS Cutoffs and Draw History";
const description = "Express Entry draws 2026: latest IRCC rounds, CRS cutoffs by draw type, year-to-date totals, the November 3 CRS changes and pause, and what to do after an ITA.";
const canonical = "https://bcpnpcalculator.ca/articles/express-entry-draws";

const faqs = [
  {
    q: "When was the last Express Entry draw?",
    a: "As of November 13, 2026, the last Express Entry draw was round 453 on October 28, 2026: a Transport occupations round that invited 150 candidates with a lowest CRS score of 477. The last Canadian Experience Class draw was round 449 on October 15, 2026 (2,500 invitations, cutoff 519), and the last Provincial Nominee Program draw was round 451 on October 26, 2026 (792 invitations, cutoff 761).",
  },
  {
    q: "Why have there been no Express Entry draws in November 2026?",
    a: "IRCC introduced a new Labour Market Integration factor in the Comprehensive Ranking System on November 3, 2026 and is recalculating the scores of all profiles already in the pool. It said the recalculation may take up to two weeks and that invitation rounds are paused until it is complete. As of November 13, 2026, IRCC's rounds data shows no round after October 28.",
  },
  {
    q: "What was the latest CEC draw cutoff?",
    a: "The latest Canadian Experience Class round, round 449 on October 15, 2026, had a cutoff of 519 with 2,500 invitations. In 2026 the 18 CEC rounds held so far had cutoffs between 507 and 523. Those scores were calculated under the old CRS grid, so they are not a reliable guide to cutoffs after the November 3 changes.",
  },
  {
    q: "How many people did Express Entry invite in 2026?",
    a: "From January 5 to October 28, 2026, IRCC held 65 rounds and issued 149,409 invitations to apply, based on our count of IRCC's official rounds data as of November 13, 2026. French-language proficiency rounds (60,500) and Canadian Experience Class rounds (57,750) made up most of that total.",
  },
  {
    q: "What does the CRS cutoff mean?",
    a: "The cutoff is the score of the lowest-ranked candidate who received an invitation in that round. Everyone eligible for the round with a higher score was invited. If several candidates had exactly the cutoff score, IRCC used the tie-breaking rule: those who submitted their profile before the published date and time were invited.",
  },
  {
    q: "How long do I have to apply after an Express Entry invitation?",
    a: "You have 60 days from the day after the invitation is issued to submit a complete application for permanent residence. You can also decline the invitation and stay in the pool. If you do neither, the invitation expires and IRCC removes your profile from the pool.",
  },
  {
    q: "Will the next Express Entry draw be a CEC draw?",
    a: "IRCC does not publish a draw schedule or announce round types in advance. Through 2026 it often held a Provincial Nominee Program round followed by a Canadian Experience Class or French-language round within a few days, but that is a past pattern, not a rule. Check IRCC's rounds page for official results.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
