---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "BC PNP for Veterinarians and Vet Technologists in 2027: Licensing, Draws and Strategy";
const description = "How veterinarians (NOC 31103) and vet technologists (NOC 32104) can use the BC PNP Care priority in 2027: CVBC/NEB licensing, RVT status and 2026 draw scores.";
const canonical = "https://bcpnpcalculator.ca/articles/bc-pnp-veterinarians-vet-technologists-2027";

const faqs = [
  {
    q: "Are veterinarians and veterinary technologists still a BC PNP priority heading into 2027?",
    a: "Yes, as of October 14, 2026. Since the April 23, 2026 restructuring, veterinary care is one of the four groups under the BC PNP's Care objective, and WelcomeBC says veterinarians and veterinary technologists who are working toward Canadian certification will be prioritized. The 2027 priorities have not been announced, so confirm on WelcomeBC before you plan around them.",
  },
  {
    q: "What scores did the 2026 Veterinary Care draws require?",
    a: "WelcomeBC published six Veterinary Care draws between May 6 and October 8, 2026. Minimum scores were 100, 92, 88, 72, 90 and 86, and each draw invited fewer than 10 people (several were listed as fewer than 5). Cutoffs move up and down with who is in the pool, so treat the range as a guide, not a promise.",
  },
  {
    q: "Do I need to be fully licensed by the CVBC before registering with the BC PNP?",
    a: "Not necessarily. The Skills Immigration Program Guide says that if your job requires mandatory licensing, you must show at application that you meet it or outline the steps you have taken to show it will shortly be met. For veterinarians, Provisional Supervised Active (PSA) registration with the CVBC is strong evidence of progress, but the BC PNP decides each case.",
  },
  {
    q: "Do vet technologists need RVT status to be invited?",
    a: "WelcomeBC's draw tables list Animal health technologists and veterinary technicians (NOC 32104) with valid professional designation as a selection factor in the Veterinary Care draws, and the program guide gives 5 extra points to vet technicians registered with the BC Veterinary Technologists Association. Registering as an RVT is therefore the safest route.",
  },
  {
    q: "Can a foreign-trained veterinarian register as an RVT while working toward a licence?",
    a: "No. The BCVTA's FAQ says it does not currently accept applications for membership from veterinarians. A foreign-trained veterinarian working in a technician role should look at the CVBC and NEB pathways instead, and must make sure the BC job offer is classified under the NOC that matches the actual duties.",
  },
  {
    q: "Is Express Entry an alternative for veterinary workers?",
    a: "It can be. IRCC's Healthcare and social services category for 2026 includes both NOC 31103 and NOC 32104, and requires at least 12 months of full-time work experience in an eligible occupation within the past 3 years. IRCC has not yet confirmed its 2027 categories.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
