<ArticleLayout slug="federal-skilled-worker-program" datePublished="2026-11-14" dateModified="2026-11-14" articleSection="Guide" keywords="federal skilled worker program, federal skilled worker, fsw canada, fswp, federal skilled worker program requirements, fsw 67 points" ogImage="/images/articles/federal-skilled-worker-program.png" title={title} description={description} canonical={canonical}>
