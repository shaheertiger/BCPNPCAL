---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Federal Skilled Worker Program 2026: Requirements, the 67-Point Grid and How FSW Candidates Get Invited";
const description = "Federal Skilled Worker Program in late 2026: minimum requirements, the FSW 67-point grid, proof of funds, fees, and what the November 3 CRS changes mean for you.";
const canonical = "https://bcpnpcalculator.ca/articles/federal-skilled-worker-program";

const faqs = [
  {
    q: "What are the Federal Skilled Worker Program requirements?",
    a: "As of November 14, 2026, IRCC lists these minimums: at least one year of continuous, paid, skilled work (or 1,560 hours, counted at up to 30 hours a week) in one occupation in NOC TEER 0, 1, 2 or 3 within the last 10 years; CLB 7 in all four abilities in English or French; a Canadian credential or a completed foreign credential with an Educational Credential Assessment; proof of funds unless you are authorized to work in Canada and have a valid job offer; admissibility; and a plan to live outside Quebec. You must also score at least 67 out of 100 on the FSW selection grid.",
  },
  {
    q: "How are the FSW 67 points calculated?",
    a: "The FSW grid has six factors worth 100 points in total: language up to 28, education up to 25, skilled work experience up to 15, age up to 12, arranged employment in Canada up to 10, and adaptability up to 10. You need 67 or more to be eligible. For example, a 30-year-old with a master's degree, CLB 9 in every ability and three years of experience scores 24 + 23 + 11 + 12 = 70 before any adaptability points.",
  },
  {
    q: "Is 67 points enough to get permanent residence through FSW?",
    a: "No. The 67-point grid only decides whether you may enter the Express Entry pool as a federal skilled worker. Invitations are issued by Comprehensive Ranking System (CRS) score, which is a separate scale with a maximum of 1,270 points under the rules in force since November 3, 2026. You still need a CRS score high enough for a round you are eligible for.",
  },
  {
    q: "Can I apply for the Federal Skilled Worker Program without a job offer?",
    a: "Yes. A job offer is not required for FSW. Without one you must show proof of funds, which as of November 14, 2026 is $15,263 for one person and $28,362 for a family of four (amounts IRCC updated on July 7, 2025). A qualifying job offer adds up to 10 FSW grid points and, since November 3, 2026, can add 50, 70 or 100 CRS points if it is in an eligible high-wage occupation.",
  },
  {
    q: "Were there any Federal Skilled Worker draws in 2026?",
    a: "IRCC held no FSW-only rounds and no general all-program rounds in 2026, according to its official rounds data as of November 14, 2026. FSW candidates could still be invited in category-based rounds they qualified for, such as French-language proficiency, healthcare and social services, trade or transport occupations, or in a Provincial Nominee Program round after getting a provincial nomination.",
  },
  {
    q: "How much does it cost to apply for FSW?",
    a: "IRCC's fee list, checked November 14, 2026, shows $1,590 for the principal applicant and $1,590 for a spouse or partner (each made up of a $990 processing fee and the $600 right of permanent residence fee), plus $270 per dependent child and $85 per person for biometrics. Language tests, an ECA, police certificates and the medical exam are paid separately to the providers.",
  },
  {
    q: "What is the difference between FSW and the Canadian Experience Class?",
    a: "FSW is for skilled workers whose experience can be gained anywhere in the world in the last 10 years, but it requires CLB 7, education with an ECA, a 67-point grid score and, usually, proof of funds. The Canadian Experience Class requires at least one year of skilled work in Canada in the last three years, has no education requirement, needs CLB 7 for TEER 0 or 1 jobs or CLB 5 for TEER 2 or 3 jobs, and does not require proof of funds.",
  },
  {
    q: "How long does FSW processing take?",
    a: "IRCC's service standard for FSW applications through Express Entry is 180 days for 80% of applications, measured from receipt of a complete application for permanent residence. That clock starts only after you are invited and submit. When we checked IRCC's processing time tool on November 14, 2026, it did not display a current FSW figure, so check the tool yourself before planning around a date.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
