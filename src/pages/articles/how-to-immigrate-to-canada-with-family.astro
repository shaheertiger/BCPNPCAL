---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "How Can We Immigrate to Canada? A 2026 Plan for Couples and Families";
const description = "How can we immigrate to Canada as a family? Pick the principal applicant, include your spouse and kids, budget fees and funds, and follow a 12–24 month plan.";
const canonical = "https://bcpnpcalculator.ca/articles/how-to-immigrate-to-canada-with-family";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How can we immigrate to Canada as a family?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most families apply on one permanent residence application. One person is the principal applicant and qualifies through a program such as Express Entry, a Provincial Nominee Program or the Atlantic Immigration Program. The spouse or common-law partner and dependent children are included on the same application and become permanent residents at the same time. If a close relative is already a Canadian citizen or permanent resident, family sponsorship may also be possible."
      }
    },
    {
      "@type": "Question",
      "name": "Can my spouse and I both apply, and who should be the principal applicant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Only one of you is the principal applicant on the permanent residence application, and the other is included as the accompanying spouse. Choose the person who scores higher or who qualifies for a stronger program: usually the partner who is younger, has higher language scores, more education or Canadian work experience, or a qualifying job offer. In Express Entry, each partner can usually create a profile listing the other as an accompanying spouse, but only one application goes ahead, and both profiles must be accurate and consistent."
      }
    },
    {
      "@type": "Question",
      "name": "Can I include my children on my Canadian PR application?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. A child is a dependent child if they are under 22 and do not have a spouse or common-law partner. Children 22 or older can qualify only if they have depended on their parents since before age 22 and cannot support themselves because of a physical or mental condition. Age is locked in on a set date, which for a Provincial Nominee Program is the date the province receives your complete nomination application, and for Express Entry programs is the date IRCC receives your complete PR application."
      }
    },
    {
      "@type": "Question",
      "name": "How much money do we need to immigrate to Canada with family?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For Express Entry applicants who must show settlement funds, the minimum is $23,360 for a family of three and $28,362 for a family of four, based on amounts IRCC updated on July 7, 2025, which were still listed as of October 2026. On top of that, IRCC fees for two adults and two children total $3,720 including the right of permanent residence fee, plus $170 for family biometrics. Medical exams, police certificates, language tests and any provincial fees are extra."
      }
    },
    {
      "@type": "Question",
      "name": "Do family members who are not coming to Canada need a medical exam?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. IRCC says family members must have a medical exam even if they are not coming with you, and they must be declared on your application. Skipping the exam for a family member can make your application refused, and a family member who was not examined generally cannot be sponsored by you later."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I do not declare a family member?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under paragraph 117(9)(d) of the Immigration and Refugee Protection Regulations, a family member who was not declared and examined when you immigrated is excluded from the family class. In practice, you generally can never sponsor that spouse or child later. Failing to declare a family member can also be treated as misrepresentation, which can lead to refusal and a five-year ban."
      }
    },
    {
      "@type": "Question",
      "name": "Can my spouse work in Canada while I work or study there?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Only in certain cases since January 21, 2025. Spouses of workers qualify for an open work permit if the worker is in a TEER 0 or 1 job, or a select TEER 2 or 3 job, with at least 16 months left on their permit. Spouses of students qualify only if the student is in a master's program of 16 months or longer, a doctoral program or select professional programs. Once the principal applicant has applied for permanent residence and holds a work permit issued because of that application, the spouse may qualify under a separate measure."
      }
    },
    {
      "@type": "Question",
      "name": "How can my family immigrate to Canada if we have a relative there?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Canadian citizen or permanent resident can sponsor a spouse, common-law or conjugal partner, or dependent child. Parent and grandparent sponsorship is paused: IRCC stopped accepting new interest-to-sponsor forms on July 15, 2026. Brothers, sisters, aunts and uncles generally cannot sponsor you, but a brother or sister in Canada who is a citizen or permanent resident adds 15 points to an Express Entry score."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take for a family to immigrate to Canada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Plan for 12 to 24 months from your first language test to landing if you already qualify for a program. IRCC aims to process 80% of complete Express Entry applications in 6 months, while applications outside Express Entry usually take longer. A temporary-first route through study or work in Canada often takes several years before permanent residence."
      }
    }
  ]
};
---

<ArticleLayout slug="how-to-immigrate-to-canada-with-family" datePublished="2026-10-18" dateModified="2026-10-18" articleSection="Guide" keywords="how can we immigrate to Canada, how to immigrate to Canada, how can we move to Canada, immigrate to Canada with family, how can my family immigrate to Canada, principal applicant, dependent child under 22, Express Entry proof of funds family" title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <div class="inline-block bg-rose-100 text-rose-800 px-4 py-1 rounded-full text-sm font-bold mb-4 border border-rose-200 shadow-sm">
        Family Planning Guide
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 leading-tight">
        How Can We Immigrate to Canada? A 2026 Plan for Couples and Families
      </h1>
      <p class="text-xl text-gray-600 mb-4">
        Moving as a household means one application, one principal applicant and one budget for everyone. Here is how to make those decisions in the right order.
      </p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <time datetime="2026-10-18">October 18, 2026</time>
        <span>&bull;</span>
        <span>14 min read</span>
      </div>
    </header>

    <div class="grid sm:grid-cols-3 gap-4 mb-10">
      <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center">
        <div class="text-3xl font-black text-indigo-600 mb-2">$28,362</div>
        <div class="text-sm text-slate-600 font-medium">Express Entry proof of funds, family of four</div>
      </div>
      <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center">
        <div class="text-3xl font-black text-green-600 mb-2">$3,890</div>
        <div class="text-sm text-slate-600 font-medium">IRCC fees and biometrics, 2 adults + 2 children</div>
      </div>
      <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center">
        <div class="text-3xl font-black text-red-600 mb-2">Under 22</div>
        <div class="text-sm text-slate-600 font-medium">Age limit for a dependent child</div>
      </div>
    </div>

    <div class="bg-indigo-50 border-l-4 border-indigo-500 p-6 mb-10 rounded-r-xl">
      <p class="font-semibold text-indigo-900 mb-2">Quick answer</p>
      <p class="text-indigo-900">
        Most couples and families immigrate to Canada on a single permanent residence application. You choose one principal applicant, usually the partner with the stronger points profile or a qualifying job offer, and include your spouse or common-law partner and dependent children under 22. That person qualifies through Express Entry, a Provincial Nominee Program, the Atlantic Immigration Program, a community pilot or Quebec's own selection, and the whole family becomes permanent residents together.
      </p>
    </div>

    <div class="prose prose-lg max-w-none">

      <p class="text-xl leading-relaxed">
        "How can we immigrate to Canada?" is a different question from "how can I?". A couple has two sets of language scores, two education histories and possibly two work records, and only one of you can be the principal applicant. Children add costs, deadlines and age rules. And since 2025, the temporary routes many families used as a stepping stone, such as a study permit with an open work permit for the spouse, have narrowed sharply. This guide is the planning layer for a household. For a full list of every permanent residence program, see our companion guide on <a href="/articles/how-to-become-permanent-resident-canada" class="text-blue-600 hover:text-blue-800 underline">how to become a permanent resident of Canada</a>.
      </p>

      <p class="text-sm text-gray-500">This article is general information, not legal advice. Every family's situation is different.</p>

      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 my-8 not-prose">
        <p class="font-bold text-slate-900 mb-3">On this page</p>
        <ol class="list-decimal pl-6 space-y-1 text-slate-700">
          <li><a href="#principal" class="text-blue-600 hover:underline">Choose the principal applicant</a></li>
          <li><a href="#who" class="text-blue-600 hover:underline">Who goes on your application</a></li>
          <li><a href="#strategy" class="text-blue-600 hover:underline">Permanent-first or temporary-first?</a></li>
          <li><a href="#routes" class="text-blue-600 hover:underline">The main routes, briefly</a></li>
          <li><a href="#fit" class="text-blue-600 hover:underline">Which route fits our family?</a></li>
          <li><a href="#money" class="text-blue-600 hover:underline">What it costs a family</a></li>
          <li><a href="#plan" class="text-blue-600 hover:underline">A 12–24 month household plan</a></li>
          <li><a href="#kids" class="text-blue-600 hover:underline">Children: school and health coverage</a></li>
          <li><a href="#mistakes" class="text-blue-600 hover:underline">Mistakes that hurt families</a></li>
          <li><a href="#faq" class="text-blue-600 hover:underline">FAQ</a></li>
        </ol>
      </div>

      <h2 id="principal" class="text-3xl font-bold mt-12 mb-6">How Can We Immigrate to Canada? Start by Choosing the Principal Applicant</h2>

      <p>
        The principal applicant is the person whose qualifications are assessed for the program. The spouse and children are "family members" on that application. You can usually choose either partner, so run the numbers both ways before you commit.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4">In Express Entry, your spouse changes your score</h3>
      <p>
        Express Entry ranks candidates with the Comprehensive Ranking System (CRS). If your spouse or common-law partner is coming with you, IRCC caps your own core points at 460 instead of 500 and lets your partner earn up to 40 points back:
      </p>

      <div class="overflow-x-auto my-8">
        <table class="min-w-full border border-slate-200 rounded-lg overflow-hidden">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">CRS factor</th>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">With accompanying spouse</th>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">Single (or spouse not coming)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="px-4 py-3 font-medium">Age (peak at 20–29)</td><td class="px-4 py-3">100</td><td class="px-4 py-3">110</td></tr>
            <tr><td class="px-4 py-3 font-medium">Education</td><td class="px-4 py-3">140</td><td class="px-4 py-3">150</td></tr>
            <tr><td class="px-4 py-3 font-medium">First official language</td><td class="px-4 py-3">150</td><td class="px-4 py-3">160</td></tr>
            <tr><td class="px-4 py-3 font-medium">Canadian work experience</td><td class="px-4 py-3">70</td><td class="px-4 py-3">80</td></tr>
            <tr><td class="px-4 py-3 font-medium">Spouse's education</td><td class="px-4 py-3">up to 10</td><td class="px-4 py-3">&mdash;</td></tr>
            <tr><td class="px-4 py-3 font-medium">Spouse's language (5 per skill)</td><td class="px-4 py-3">up to 20</td><td class="px-4 py-3">&mdash;</td></tr>
            <tr><td class="px-4 py-3 font-medium">Spouse's Canadian work experience</td><td class="px-4 py-3">up to 10</td><td class="px-4 py-3">&mdash;</td></tr>
          </tbody>
        </table>
      </div>

      <p>
        What this means in practice: the partner who is younger, has the higher language scores (especially CLB 9 or above), more education or Canadian work experience usually makes the better principal applicant. A partner with a strong test result is still worth testing even as the spouse, because those 20 language points can decide an invitation. French matters too: CRS gives up to 50 extra points for French skills, and French-language draws have been some of the lowest-scoring in recent years. Our <a href="/articles/canada-pr-planning-guide-french-advantage-2026" class="text-blue-600 hover:text-blue-800 underline">French advantage guide</a> covers this.
      </p>

      <div class="bg-amber-50 border-l-4 border-amber-500 p-6 my-8">
        <p class="font-semibold text-amber-900 mb-2">New from November 3, 2026</p>
        <p class="text-amber-800">IRCC announced on October 16, 2026 that a new Labour Market Integration factor will be added to the CRS. It awards points for Canadian work experience or a job offer in a high-wage occupation (one whose national median wage is at least 1.3 times the average), whichever gives you more, and removes the LMIA requirement for job offers. Job offers can earn 50, 70 or 100 points depending on the occupation's wage level. For couples, this can change who should be principal applicant: compare both partners' occupations. Profiles will be rescored and draws paused for up to two weeks.</p>
      </div>

      <p>
        Each partner can usually keep their own Express Entry profile with the other listed as an accompanying spouse; whoever is invited applies, and only one application goes forward. Keep the two profiles consistent. Never list a spouse as "not accompanying" to drop to single-applicant scoring if you actually plan to move together. That is misrepresentation.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4">In a provincial program, the job usually decides</h3>
      <p>
        Most provincial streams are built around a job offer or work history in that province, so the principal applicant is normally the partner with the qualifying job. British Columbia's registration system (SIRS) does not award points for a spouse at all; your partner's language and education only matter later if you use the Express Entry BC option. Check where you stand with the <a href="/bc-pnp-calculator" class="text-indigo-600 underline font-semibold">BC PNP Calculator</a>, and read our <a href="/articles/bc-pnp-spouse-family-guide-2026" class="text-blue-600 hover:text-blue-800 underline">BC PNP spouse and family guide</a> for B.C.-specific rules.
      </p>

      <h2 id="who" class="text-3xl font-bold mt-12 mb-6">Immigrate to Canada With Family: Who Goes on Your Application</h2>

      <ul class="list-disc pl-6 space-y-3">
        <li><strong>Spouse:</strong> a legally married partner.</li>
        <li><strong>Common-law partner:</strong> someone you have lived with in a conjugal relationship for at least 12 continuous months. Keep proof such as a joint lease, shared bills and bank accounts.</li>
        <li><strong>Dependent children:</strong> your children, and your spouse's or partner's children, who are under 22 and do not have a spouse or common-law partner. A child 22 or older qualifies only if they have depended on their parents since before age 22 and cannot support themselves because of a physical or mental condition.</li>
      </ul>

      <h3 class="text-2xl font-semibold mt-8 mb-4">Age is locked in, but on different dates</h3>
      <p>
        IRCC uses the child's age on a "lock-in date", even if they turn 22 during processing. That date depends on the program:
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Provincial Nominee Program:</strong> the date the province receives your complete nomination application.</li>
        <li><strong>Express Entry programs</strong> (Canadian Experience Class, Federal Skilled Worker, Federal Skilled Trades): the date IRCC receives your complete PR application.</li>
        <li><strong>Atlantic Immigration Program:</strong> the date the province receives your complete endorsement application.</li>
        <li><strong>Quebec skilled workers:</strong> the date Quebec receives your complete selection certificate (CSQ) application.</li>
      </ul>
      <p>
        If a child is about to turn 22, the speed of that first filing matters more than anything else in your plan.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4">Non-accompanying family members still count</h3>
      <p>
        A spouse who will stay behind, or a child living with a former partner, is still a family member. They must be declared, they usually must have an immigration medical exam, and they count toward Express Entry proof of funds. The <a href="#mistakes" class="text-blue-600 hover:text-blue-800 underline">mistakes section</a> explains why this is the rule families can least afford to get wrong.
      </p>

      <h2 id="strategy" class="text-3xl font-bold mt-12 mb-6">Permanent-First or Temporary-First?</h2>

      <p>
        There are two basic strategies. <strong>Permanent-first</strong> means the principal applicant qualifies for permanent residence from where you live now and the family lands together as permanent residents. <strong>Temporary-first</strong> means one of you comes on a study or work permit, gains Canadian experience, and applies for PR from inside Canada. Temporary-first used to be the default for many families. In 2025 and 2026 it became harder and riskier.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4">What changed for temporary-first families</h3>
      <ul class="list-disc pl-6 space-y-3">
        <li><strong>Fewer study permits.</strong> IRCC plans to issue up to 408,000 study permits in 2026, of which about 155,000 are for new students; most college and undergraduate applicants also need a provincial attestation letter. Master's and doctoral students at public institutions have been exempt from the attestation requirement since January 1, 2026.</li>
        <li><strong>Spousal open work permits narrowed.</strong> Since January 21, 2025, spouses of students qualify only if the student is in a master's program of 16 months or longer, a doctoral program or select professional programs. Spouses of workers qualify only if the worker is in a TEER 0 or 1 job, or a select TEER 2 or 3 job, with at least 16 months left on their permit. Dependent children of those workers no longer get their own open work permits.</li>
        <li><strong>PGWP conditions.</strong> A post-graduation work permit is a one-time opportunity. Graduates of non-degree college programs must have studied in an eligible field (IRCC froze that list for 2026), while bachelor's, master's and doctoral graduates are exempt from the field rule.</li>
        <li><strong>A shrinking temporary population.</strong> The federal government wants temporary residents below 5% of the population by the end of 2027. Statistics Canada estimated 6.7% on July 1, 2026. The 2026 target for new temporary arrivals is 385,000. See our guide to the <a href="/articles/canada-temporary-resident-cap-2027-bc-work-permit-holders" class="text-blue-600 hover:text-blue-800 underline">temporary resident target</a> for how this affects people already here.</li>
      </ul>

      <p>
        There is one family-friendly rule worth knowing. Once the principal applicant has applied for economic-class PR and holds a work permit issued because of that application, such as a bridging open work permit, the spouse and dependent children of working age may qualify for open work permits if that permit has at least six months left. IRCC has also added narrow spousal measures in 2026, including for Quebec PSTQ applicants and workers on designated major projects in B.C.
      </p>

      <div class="bg-blue-50 border-l-4 border-blue-500 p-6 my-8">
        <p class="font-semibold text-blue-900 mb-2">Our view</p>
        <p class="text-blue-800">If either partner can qualify for permanent residence now, go permanent-first. Temporary-first still works for families with a graduate-level study plan or a high-skill job offer, but budget for several years on temporary status, international tuition, and the chance that your spouse cannot work during part of that time.</p>
      </div>

      <h2 id="routes" class="text-3xl font-bold mt-12 mb-6">How to Immigrate to Canada: The Main Routes, Briefly</h2>

      <p>
        Every route below lets you include your spouse and dependent children. For eligibility details, see the <a href="/articles/how-to-become-permanent-resident-canada" class="text-blue-600 hover:text-blue-800 underline">full PR program guide</a>.
      </p>

      <ul class="list-disc pl-6 space-y-3">
        <li><strong>Express Entry</strong> (federal; 109,000 admissions targeted in 2026). Covers the Canadian Experience Class, Federal Skilled Worker and Federal Skilled Trades programs. IRCC also runs category draws; 2026 categories include healthcare and social services, education, trades, STEM and French, plus newer ones such as physicians, researchers and senior managers with Canadian experience. See <a href="/articles/express-entry-2027-category-changes" class="text-blue-600 hover:text-blue-800 underline">what may change in 2027</a>.</li>
        <li><strong>Provincial Nominee Programs</strong> (91,500 admissions targeted in 2026). Usually built around a job offer or work in the province. Compare provinces in <a href="/articles/best-provinces-pnp-2027" class="text-blue-600 hover:text-blue-800 underline">best provinces for PNP</a>.</li>
        <li><strong>Atlantic Immigration Program</strong> (4,000 in 2026). Requires a job offer from a designated employer in Nova Scotia, New Brunswick, PEI or Newfoundland and Labrador. See <a href="/articles/bc-pnp-vs-atlantic-immigration-2026" class="text-blue-600 hover:text-blue-800 underline">BC PNP vs Atlantic</a>.</li>
        <li><strong>Rural and Francophone Community Immigration Pilots</strong> (RCIP and FCIP). Job offer from a designated employer in a participating community plus a community recommendation. See our <a href="/articles/rcip-fcip-rural-francophone-immigration-pilots-2026" class="text-blue-600 hover:text-blue-800 underline">RCIP and FCIP guide</a>.</li>
        <li><strong>Family sponsorship</strong> (69,000 spouses, partners and children targeted in 2026). A Canadian citizen or permanent resident can sponsor a spouse, partner or dependent child. New parent and grandparent applications have been paused since July 15, 2026.</li>
        <li><strong>Quebec.</strong> Quebec selects its own economic immigrants, mainly through the Skilled Worker Selection Program (PSTQ) and its Arrima invitation system. You first get a Quebec Selection Certificate (CSQ), then apply to IRCC. French is central to Quebec selection.</li>
      </ul>

      <h2 id="fit" class="text-3xl font-bold mt-12 mb-6">Which Route Fits Our Family?</h2>

      <div class="overflow-x-auto my-8">
        <table class="min-w-full border border-slate-200 rounded-lg overflow-hidden">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">Our situation</th>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">Route to look at first</th>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">Watch out for</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="px-4 py-3 font-medium">One partner has a year of skilled work in Canada</td><td class="px-4 py-3">Express Entry (Canadian Experience Class); no proof of funds needed</td><td class="px-4 py-3">Keep everyone's temporary status valid while you wait</td></tr>
            <tr><td class="px-4 py-3 font-medium">Both abroad, young, degrees, strong English or French</td><td class="px-4 py-3">Express Entry (Federal Skilled Worker), with the stronger partner as principal</td><td class="px-4 py-3">Proof of funds for every family member, even those not coming</td></tr>
            <tr><td class="px-4 py-3 font-medium">One partner has a job offer in a specific province</td><td class="px-4 py-3">That province's PNP; in B.C., Skills Immigration</td><td class="px-4 py-3">The job must fit the province's current priorities</td></tr>
            <tr><td class="px-4 py-3 font-medium">Healthcare or trades worker, moderate CRS</td><td class="px-4 py-3">Express Entry category draws and provincial healthcare or trades streams</td><td class="px-4 py-3">Licensing or certification is often needed first</td></tr>
            <tr><td class="px-4 py-3 font-medium">Open to smaller communities or Atlantic Canada</td><td class="px-4 py-3">Atlantic Immigration Program, RCIP, FCIP or regional PNP streams</td><td class="px-4 py-3">Employer must be designated; intent to live there must be genuine</td></tr>
            <tr><td class="px-4 py-3 font-medium">One partner is a Canadian citizen or PR</td><td class="px-4 py-3">Spousal or common-law sponsorship, including the partner's children</td><td class="px-4 py-3">Sponsor must meet residency and undertaking rules</td></tr>
            <tr><td class="px-4 py-3 font-medium">French-speaking family</td><td class="px-4 py-3">Express Entry French draws, FCIP, or Quebec's PSTQ</td><td class="px-4 py-3">You need a valid TEF Canada or TCF Canada result</td></tr>
            <tr><td class="px-4 py-3 font-medium">Planning a master's or PhD for one partner</td><td class="px-4 py-3">Temporary-first: study permit, then PGWP, then PR</td><td class="px-4 py-3">Spouse open work permit only for eligible programs; international tuition</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="money" class="text-3xl font-bold mt-12 mb-6">What It Costs to Immigrate to Canada as a Family</h2>

      <h3 class="text-2xl font-semibold mt-8 mb-4">Proof of funds (Express Entry)</h3>
      <p>
        Federal Skilled Worker and Federal Skilled Trades applicants must show settlement funds unless they are authorized to work in Canada and have a valid job offer. Canadian Experience Class applicants are exempt. The amount is based on family size, and you must count your spouse and dependent children, plus your spouse's dependent children, even if they are not coming or are already Canadian. The amounts below are from IRCC's table updated July 7, 2025, which was still the current table in October 2026. IRCC normally updates it once a year, so check before you submit.
      </p>

      <div class="overflow-x-auto my-8">
        <table class="min-w-full border border-slate-200 rounded-lg overflow-hidden">
          <thead class="bg-slate-100">
            <tr>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">Family members</th>
              <th class="px-4 py-3 text-left text-sm font-bold text-slate-700">Funds required (CAD)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr><td class="px-4 py-3">1</td><td class="px-4 py-3">$15,263</td></tr>
