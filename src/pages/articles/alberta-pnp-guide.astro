---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Alberta PNP Guide 2026: AAIP Streams, Requirements, EOI, Fees and Processing Times";
const description = "Alberta PNP (AAIP) guide for late 2026: worker and entrepreneur streams, EOI points, $135 and $1,500 fees, processing dates and the 6,603 nomination allocation.";
const canonical = "https://bcpnpcalculator.ca/articles/alberta-pnp-guide";

const faqs = [
  {
    q: "What is the Alberta PNP?",
    a: "The Alberta PNP is the Alberta Advantage Immigration Program (AAIP), Alberta's provincial nominee program. It nominates workers and entrepreneurs for permanent residence. A nomination does not give you PR by itself: you then apply to Immigration, Refugees and Citizenship Canada (IRCC), which makes the final decision. As of November 12, 2026, the AAIP has four worker streams and four entrepreneur streams.",
  },
  {
    q: "What are the Alberta PNP requirements?",
    a: "They depend on the stream. To enter the worker pool you need at least CLB 4 (or NCLC 4) in all four language skills to submit a Worker Expression of Interest. The Alberta Opportunity Stream then requires a valid eligible work permit, a full-time Alberta job offer in your current occupation, CLB 5 for TEER 0-3 jobs or CLB 4 for TEER 4-5 jobs, high school education equivalent to Canadian standards, and 12 months of full-time work in that occupation in Alberta within the last 18 months (or 24 months within 30 months in Canada or abroad). The Alberta Express Entry Stream requires an active Express Entry profile and a CRS score of at least 300.",
  },
  {
    q: "Can I apply for the Alberta PNP without a job offer?",
    a: "The Alberta Opportunity, Rural Renewal and Tourism and Hospitality streams all require an Alberta job offer, and the Rural Renewal Stream also needs a community endorsement. The Alberta Express Entry Stream can invite candidates without an Alberta job offer in some draws, for example priority sector draws based on experience in construction, agriculture or aviation, but the dedicated health care, tech and law enforcement pathways all require a job offer. In practice most nominations go to people already working in Alberta.",
  },
  {
    q: "How long does the Alberta PNP take to process?",
    a: "Alberta does not publish a single processing time. Its processing page, last updated November 4, 2026, lists the application date it is currently assessing for each stream: for example, Alberta Opportunity Stream applications received on or before August 2, 2026, Rural Renewal Stream applications received on or before October 9, 2026, and Tourism and Hospitality Stream applications received on or before November 2, 2026. After nomination, IRCC's own permanent residence processing time applies on top.",
  },
  {
    q: "How much does the Alberta PNP cost?",
    a: "Under the AAIP fee schedule effective April 7, 2026, a Worker Expression of Interest costs $135 and a worker stream application costs $1,500. Entrepreneur streams charge $200 for an Entrepreneur Expression of Interest (Graduate, Foreign Graduate and Rural Entrepreneur streams) and $3,500 for the application. A request for reconsideration costs $250. Federal PR fees, language tests, credential assessments and medical exams are extra.",
  },
  {
    q: "How many nominations does Alberta have in 2026?",
    a: "Alberta's 2026 allocation is 6,603 nominations, after IRCC added 200 spaces on August 10, 2026. As of the November 4, 2026 processing update, 6,108 had been issued and 495 spaces remained. Nominations for practice-ready physicians and Francophones under a federal initiative do not count toward the 6,603; Alberta reported 50 physician and 12 Francophone nominations through those extra spaces.",
  },
  {
    q: "Is the Alberta PNP easier than the BC PNP?",
    a: "Neither is easy, and they reward different profiles. Alberta's 2026 allocation (6,603) is slightly larger than B.C.'s (6,254), and Alberta's Alberta Opportunity Stream accepts most TEER 0-5 occupations for people already working in the province. B.C. now invites mainly through targeted Care, Build and Innovate rounds. The better choice depends on where your job offer is and what your occupation is. Our BC PNP vs Alberta AAIP comparison goes through it in detail.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
