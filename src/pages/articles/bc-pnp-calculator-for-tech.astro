---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { calculateTotalPoints, calculateAnnualWage } from "../../utils/calculatePoints";
import { EXAMPLE_PROFILES } from "../../data/example-profiles";
import { TECH_NOCS } from "../../data/tech-nocs";
import { highImpactDraws2026 } from "../../data/bcpnp-draws";
import { LINKS } from "../../data/site-links";
import { latestFor, latestHeiWage } from "../../utils/draws";

const GUIDE = "https://www.welcomebc.ca/immigrate-to-b-c/bc-pnp-si-program-guide-pdf";
const ITA_PAGE = "https://www.welcomebc.ca/immigrate-to-b-c/about-the-bc-provincial-nominee-program/invitations-to-apply";

const hei = latestFor("hei-points");
const heiScore = hei.score as number;
const heiWage = highImpactDraws2026.find((d) => d.date === latestHeiWage.date)!;
const fmt = (n: number) => n.toLocaleString("en-CA");

const title = "BC PNP Tech 2026: Eligible NOC Codes and Your Score";
const description = `${TECH_NOCS.length} tech NOC codes are on the Program Guide list. Tech draws ended Dec 2024; tech workers now need ${heiScore} points or $${heiWage.hourly}/hr in High Economic Impact draws.`;

// Worked example: the site's "tech" profile, scored by the calculator engine,
// plus the same person with an example offer at the latest wage-track hourly
// threshold. Wages are example offers, not wage data.
const base = EXAMPLE_PROFILES.find((p) => p.id === "tech")!;
const r1 = calculateTotalPoints(base.state);
const variantWage = heiWage.hourly;
const r2 = calculateTotalPoints({ ...base.state, hourlyWage: variantWage });
const variantAnnual = calculateAnnualWage(variantWage);
const baseAnnual = calculateAnnualWage(base.state.hourlyWage);
const meetsWage = (h: number) => h >= heiWage.hourly && calculateAnnualWage(h) >= heiWage.annual;
const b1 = r1.breakdown;
const teer = (noc: string) => noc.charAt(1);

const faqs = [
  {
    q: "Is there still a BC PNP tech stream in 2026?",
    a: `No. There is no separate tech stream or tech draw. WelcomeBC held the last draw for priority technology occupations on December 3, 2024. Tech workers register in the Skilled Worker stream and are invited through Innovate: High Economic Impact draws.`,
  },
  {
    q: "What BC PNP score do tech workers need?",
    a: `There is no tech-specific minimum. The latest High Economic Impact points draw, on ${hei.date}, needed ${heiScore} points. The same draw also invited candidates with a TEER 0–3 job offer paying at least $${heiWage.hourly} an hour and $${fmt(heiWage.annual)} a year, whatever their score.`,
  },
  {
    q: "Can a contract tech job qualify for BC PNP?",
    a: `Yes, for the ${TECH_NOCS.length} technology occupations in Appendix A of the Program Guide, if the offer is for at least one year (365 days) and has at least 120 calendar days left when you apply. Other occupations need an indeterminate offer.`,
  },
  {
    q: "Do tech workers need a job offer for BC PNP?",
    a: "Yes. You need a full-time job offer (an average of at least 30 hours a week) from an eligible B.C. employer that supports your application.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const a = "text-red-600 font-semibold underline underline-offset-2 hover:text-red-700";
const ext = "text-red-600 underline underline-offset-2 hover:text-red-700";
const h2 = "text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-12 mb-4";
const p = "text-slate-700 leading-relaxed mb-4";
---

<ArticleLayout
  slug="bc-pnp-calculator-for-tech"
  datePublished="2026-01-29"
  dateModified="2026-11-26"
  keywords="BC PNP tech, BC PNP tech NOC list, BC PNP tech draw, BC PNP score tech workers"
  title={title}
  description={description}
  jsonLd={jsonLd}
  related={["hei", "workExperience", "jobOffer"]}
>
  <article class="bg-slate-50 py-10 sm:py-14 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <header class="mb-8">
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          Which tech jobs are eligible for BC PNP?
        </h1>
        <p class="mt-4 text-lg text-slate-700 leading-relaxed">
          {TECH_NOCS.length} technology occupations, from software developers (NOC 21232) to graphic designers (52120), are listed in the BC PNP Program Guide, but tech draws ended on December 3, 2024. Tech workers now compete in High Economic Impact draws, which on {hei.date} needed {heiScore} points or a wage of at least ${heiWage.hourly}/hr.
        </p>
      </header>

      <aside class="rounded-2xl border border-red-100 bg-white p-6 mb-10" aria-label="Key facts">
        <p class="text-xs font-black uppercase tracking-widest text-red-600 mb-3">Key facts</p>
        <ul class="space-y-2 text-slate-800 text-sm sm:text-base">
          <li><strong>Tech list:</strong> {TECH_NOCS.length} NOC codes in Appendix A of the Program Guide; these can qualify with a job offer of at least one year instead of an indeterminate one.</li>
          <li><strong>Stream:</strong> Skilled Worker, which needs 2 years of full-time skilled (TEER 0–3) experience from the last 10 years.</li>
          <li><strong>Tech draws:</strong> none since December 3, 2024.</li>
          <li><strong>Latest High Economic Impact draw ({hei.date}):</strong> {heiScore} points, or ${heiWage.hourly}/hr and ${fmt(heiWage.annual)}/yr in a TEER 0–3 job.</li>
        </ul>
      </aside>

      <h2 class={h2}>Is there still a BC PNP tech draw?</h2>
      <p class={p}>
        No. WelcomeBC's <a href={ITA_PAGE} target="_blank" rel="noopener noreferrer" class={ext}>invitations page</a> records the final draw for priority technology occupations on December 3, 2024. In 2026, BC invites skilled workers in three kinds of rounds: Care (health, childcare, veterinary and education occupations), Build (construction trades) and Innovate: High Economic Impact. Tech occupations are not in the Care or Build groups, so tech workers are invited in the <a href={LINKS.hei.href} class={a}>{LINKS.hei.short}</a>, which have two tracks: a points cut-off and a wage rule.
      </p>

      <h2 class={h2}>Which tech jobs are eligible for BC PNP? The {TECH_NOCS.length} NOC codes</h2>
      <p class={p}>
        Appendix A of the <a href={GUIDE} target="_blank" rel="noopener noreferrer" class={ext}>Skills Immigration Program Guide</a> (effective June 10, 2026) lists these technology occupations. For them, the job offer does not have to be indeterminate if it is for a single job lasting at least 365 days with at least 120 calendar days left at the time of application. Any other TEER 0–3 occupation can also use the Skilled Worker stream with an indeterminate offer, unless it is on the ineligible list in section 3.11.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 mb-3 max-h-[32rem] overflow-y-auto">
        <table class="w-full text-sm text-left bg-white">
          <caption class="sr-only">BC PNP technology occupations (Program Guide Appendix A)</caption>
          <thead class="bg-slate-100 text-slate-900 sticky top-0">
            <tr>
              <th scope="col" class="px-3 py-2.5 font-bold">NOC</th>
              <th scope="col" class="px-3 py-2.5 font-bold">Occupation</th>
              <th scope="col" class="px-3 py-2.5 font-bold">TEER</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {TECH_NOCS.map((n) => (
              <tr>
                <td class="px-3 py-2 font-bold text-slate-900">{n.noc}</td>
                <td class="px-3 py-2 text-slate-700">{n.title}</td>
                <td class="px-3 py-2 text-slate-700">{teer(n.noc)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 mb-6">
        Source: Appendix A, <a href={GUIDE} target="_blank" rel="noopener noreferrer" class="underline">BC PNP Skills Immigration Program Guide</a>. TEER is the second digit of the 2021 NOC code.
      </p>

      <h2 class={h2}>What score do tech workers need for BC PNP?</h2>
      <p class={p}>
        In the latest High Economic Impact round, on {hei.date}, the points track invited candidates with {heiScore} or more, and the wage track invited anyone with a TEER 0–3 job offer paying at least ${heiWage.hourly} an hour and ${fmt(heiWage.annual)} a year, regardless of score. Earlier 2026 rounds and every other stream are on the <a href={LINKS.draws.href} class={a}>{LINKS.draws.short}</a> page. Because both tracks run in the same draw, a high wage can get a tech worker invited even with a modest score.
      </p>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 my-6" id="worked-example">
        <p class="text-xs font-black uppercase tracking-widest text-slate-500 mb-2">Worked example</p>
        <p class="text-slate-800 leading-relaxed">
          A software developer (NOC 21232) in Vancouver with 4 years of experience (1 in Canada), working for the employer now, a bachelor's degree from outside Canada, CLB 8 and an example offer of ${base.state.hourlyWage.toFixed(2)}/hr scores <strong>{r1.total}</strong>: {b1.experience + b1.canadianExp + b1.currentBCJob} for experience, {b1.educationTotal} for education, {b1.languageTotal} for language, {b1.wage} for wage and {b1.area + b1.regionalBonus} for working in Metro Vancouver.
        </p>
        <p class="text-slate-700 leading-relaxed mt-3">
          That is {heiScore - r1.total} points short of the {heiScore} points cut-off, and ${base.state.hourlyWage.toFixed(2)}/hr (${fmt(baseAnnual)} a year at 40 hours a week) {meetsWage(base.state.hourlyWage) ? "meets" : "does not meet"} the wage rule. With an example offer of ${variantWage.toFixed(2)}/hr the same person scores {r2.total}, still {r2.total >= heiScore ? "above" : "below"} the points cut-off, but ${fmt(variantAnnual)} a year at 40 hours a week {meetsWage(variantWage) ? `meets both parts of the $${heiWage.hourly}/hr and $${fmt(heiWage.annual)}/yr wage rule, so they would have qualified on the wage track` : "still does not meet the wage rule"}.
        </p>
      </div>

      <h2 class={h2}>How do tech workers qualify for the Skilled Worker stream?</h2>
      <p class={p}>
        You need a full-time job offer (an average of at least 30 hours a week) from an eligible B.C. employer, at least 2 years of full-time or equivalent experience in any TEER 0–3 occupation within the last 10 years, and the qualifications for the job (Program Guide 4.1). The <a href={LINKS.workExperience.href} class={a}>{LINKS.workExperience.short}</a> explain how that minimum differs from the directly related experience that earns points. Your offered wage must sit within the WorkBC or Job Bank range for the occupation and location (3.9). For TEER 0 and 1 jobs, a language test is optional unless you claim points for it (3.4).
      </p>

      <h2 class={h2}>How to calculate your BC PNP score as a tech worker</h2>
      <p class={p}>
        Wage is scored in $1 bands: $16.00 to $16.99 earns 1 point, each extra dollar adds 1, and $70 or more earns the maximum 55 (Program Guide 8.4). There is no bonus for earning above the median wage. Directly related experience must be in the same NOC as the offer, or a related one at the same or a higher TEER (8.1). Enter your details in the <a href={LINKS.calculator.href} class={a}>{LINKS.calculator.short}</a> to see each factor.
      </p>

      <h2 class={h2}>Common mistakes</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-700 leading-relaxed mb-6">
        <li><strong>Waiting for a tech draw.</strong> None has been held since December 3, 2024.</li>
        <li><strong>Counting stock options or bonuses as wage.</strong> Only the hourly rate counts; bonuses, commissions and profit-sharing are excluded (3.9).</li>
        <li><strong>Using a contract offer in a non-tech occupation.</strong> The limited-term exception covers only Appendix A occupations, and only for offers of at least 365 days.</li>
        <li><strong>Choosing a NOC by title, not duties.</strong> Points for directly related experience depend on the NOC matching your past work.</li>
        <li><strong>Working remotely for a company outside B.C.</strong> The employer must have a significant operational presence in B.C. and direct your work (3.12).</li>
      </ul>

      <h2 class={h2}>FAQ: BC PNP for tech workers</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="font-black text-slate-900 mb-2">{f.q}</h3>
            <p class="text-slate-700 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>

      <p class="text-xs text-slate-500 mt-8">
        Draw results from <a href={ITA_PAGE} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC</a>; eligibility rules from the BC PNP Skills Immigration Program Guide (effective June 10, 2026). General information, not legal advice.
      </p>
    </div>
  </article>
</ArticleLayout>
