import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Canada's 5% Temporary Resident Target: What It Means for BC Work Permit Holders in 2027";
const description = "Canada wants temporary residents below 5% of the population by end-2027. What it means for BC work permit holders: PGWP expiry, maintained status, PR bridges.";
const canonical = "https://bcpnpcalculator.ca/articles/canada-temporary-resident-cap-2027-bc-work-permit-holders";

const faqs = [
  {
    q: "What exactly is Canada's 5% temporary resident target?",
    a: "The federal government has committed to reducing Canada's temporary population to less than 5% of the total population by the end of 2027. Statistics Canada estimated 2,779,774 non-permanent residents on July 1, 2026, or 6.7% of the population, down from a peak of 7.2% on October 1, 2024 in its revised series.",
  },
  {
    q: "Will my work permit be cancelled because of the 5% target?",
    a: "No measure announced so far cancels valid work permits. The government's plan relies on fewer new arrivals, permits expiring, people leaving and people transitioning to permanent residence. The practical effect for you is that extensions and new permits are harder to get, so your expiry date becomes the date your plan must work around.",
  },
  {
    q: "Can I extend my PGWP if my BC PNP application is still in progress?",
    a: "Generally no. IRCC says post-graduation work permits are a one-time opportunity; the main exception is when your PGWP was shortened because your passport expired. Most PGWP holders need another basis to stay, such as an employer-specific permit, a BC PNP work permit support letter after nomination, or a bridging open work permit once a qualifying permanent residence application is in process.",
  },
  {
    q: "What is maintained status and does it protect me?",
    a: "If you apply to extend or change your work permit before it expires, you can legally stay in Canada until IRCC decides, and you can generally keep working under the same conditions. If you miss the deadline, you have no maintained status: you may apply to restore your status within 90 days, but you normally cannot work until status is restored and a new permit is issued.",
  },
  {
    q: "Does the BC PNP help work permit holders whose permits are expiring?",
    a: "After nomination, the BC PNP may issue a work permit support letter that lets you apply for a work permit without an LMIA, if your permit will expire in the near future and you continue to meet the conditions of nomination. The BC PNP cannot apply for the permit for you, and it will not nominate anyone who is out of status.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
