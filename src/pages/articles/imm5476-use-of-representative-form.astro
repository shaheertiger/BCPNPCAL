---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "IMM 5476 Use of a Representative Form: How to Fill It In (2026 Guide)";
const description = "How to fill in IRCC form IMM 5476 (11-2025 edition): paid vs unpaid representatives, sections A to E, signatures, family members, submitting and cancelling.";
const canonical = "https://bcpnpcalculator.ca/articles/imm5476-use-of-representative-form";

const faqs = [
  {
    q: "What is the IMM 5476 form used for?",
    a: "IMM 5476, Use of a Representative, is the IRCC form you use to appoint a paid or unpaid representative to deal with Immigration, Refugees and Citizenship Canada and the Canada Border Services Agency on your behalf. The same form is used to update your representative's contact details, cancel a representative, cancel one and appoint a new one, or for a representative to withdraw from your file.",
  },
  {
    q: "Where can I download the IMM 5476 form?",
    a: "Download it free from the IMM 5476 page on canada.ca. As of November 14, 2026 the current edition is 11-2025 (the footer of each page reads IMM 5476 (11-2025) E). IRCC accepted earlier versions only until March 12, 2026, so do not reuse an old copy. Open the PDF in Adobe Reader rather than a browser so the fillable fields work.",
  },
  {
    q: "Who can be a paid immigration representative in Canada?",
    a: "Only authorized representatives can charge a fee or receive any other compensation: members in good standing of the College of Immigration and Citizenship Consultants (CICC), lawyers who belong to a Canadian provincial or territorial law society (and students-at-law under a supervising lawyer), notaries of the Chambre des notaires du Quebec, and, in Ontario only, paralegals licensed by the Law Society of Ontario. IRCC says it will not deal with unauthorized representatives who charge a fee.",
  },
  {
    q: "Does each family member need their own IMM 5476?",
    a: "Usually some of them do. Dependent children under 18 are covered by the principal applicant's signature. Dependent children aged 18 or older need their own form if the representative will conduct business for them, and for most applications a spouse or common-law partner needs a separate form even when included in the same application. In a sponsorship application, the sponsor's spouse or partner can sign in the box provided in Section E instead.",
  },
  {
    q: "How do I submit IMM 5476 after my application has already been sent?",
    a: "If you applied online and the application is already submitted, send the form through the IRCC web form. If you applied on paper and it is already submitted, use the web form or mail it to the IRCC office processing your application. If your application has not been submitted yet, simply upload the form with an online application, or include it in the paper package.",
  },
  {
    q: "How do I cancel my immigration representative?",
    a: "Complete a new IMM 5476 and tick the box for cancelling the appointment. Fill in Sections A, C and E, then send it to IRCC the same way you would submit the form. If you want a new representative at the same time, complete Sections A, B, C and E. IRCC will then send correspondence to the email address you give in Section A.",
  },
  {
    q: "Is IMM 5476 used for the BC PNP?",
    a: "No. The BC PNP is run by the Province of British Columbia and uses its own Use of a Representative Form - Applicant, uploaded in the My Representative section of the BCPNP Online portal. If you later apply to IRCC for permanent residence as a provincial nominee and want a representative on that federal application, you need an IMM 5476 as well.",
  },
  {
    q: "Is IMM 5476 the same as IMM 5475?",
    a: "No. IMM 5476 appoints a representative who can act for you. IMM 5475, Authority to Release Personal Information to a Designated Individual, only lets IRCC share information about your file with a person you name. That person cannot conduct business for you.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
