---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "BC PNP Guides & Resources 2026 | Comprehensive Immigration Resources";
const description = "Complete collection of BC PNP guides covering eligibility, streams, processing times, documents, and strategies. Free resources to help you navigate British Columbia immigration.";
---

<BaseLayout title={title} description={description}>
  <article class="min-h-screen bg-slate-50 py-16 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">

      <header class="mb-12 text-center">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight mb-4">
          BC PNP <span class="text-red-600">Guides & Resources</span>
        </h1>
        <div class="h-1 w-20 bg-red-600 mx-auto rounded-full mb-6"></div>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          Comprehensive guides and resources to help you understand the BC Provincial Nominee Program. All content is free, regularly updated, and based on official BC PNP criteria.
        </p>
      </header>

      <!-- Canadian PR Section -->
      <section class="mb-16" id="canadian-pr">
        <div class="flex items-center mb-6">
          <div class="h-12 w-1 bg-red-600 rounded-full mr-4"></div>
          <h2 class="text-3xl font-black text-slate-900">Getting PR in Canada</h2>
