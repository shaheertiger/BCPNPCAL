---
// BC PNP draw calculator. The points calculator (query family "bc pnp
// calculator / points calculator") lives on the homepage; this page owns
// "bc pnp draw calculator / will my score get invited". See docs/query-map.md.
import BaseLayout from "../layouts/BaseLayout.astro";
import RelatedLinks from "../components/seo/RelatedLinks.astro";
import { DRAWS_SOURCE_URL, DRAWS_LAST_UPDATED_ISO } from "../data/bcpnp-draws";
import { LINKS } from "../data/site-links";
import { streamRows, latestFor, STREAM_SHORT, shortDate, fmtCountShort, type StreamKey } from "../utils/draws";

const SITE = "https://bcpnpcalculator.ca";
const streams: { key: StreamKey; label: string; who: string }[] = [
  { key: "hei-points", label: "High Economic Impact (points)", who: "Any eligible skilled job (TEER 0–3) not covered by a Care or Build draw, including tech" },
  { key: "health", label: "Care: Health", who: "Priority health occupations with a private or non-health-authority employer" },
  { key: "childcare", label: "Care: Childcare", who: "Early childhood educators (NOC 42202) with a One Year or Five Year ECE certificate" },
  { key: "construction", label: "Build: Construction Trades", who: "Priority construction occupations" },
  { key: "veterinary", label: "Care: Veterinary Care", who: "Priority veterinary care occupations" },
  { key: "education", label: "Care: Education", who: "Priority education occupations (the 2026 round targeted French-speaking teachers)" },
];
const data = streams.map((s) => ({ ...s, rows: streamRows(s.key), latest: latestFor(s.key) }));
const totalDraws = data.reduce((n, s) => n + s.rows.length, 0);

const title = "BC PNP Draw Calculator 2026: Would Your Score Get Invited?";
const description = `Enter your SIRS score to see which of ${totalDraws} BC PNP draws in 2026 it would have cleared. Latest: Health ${latestFor("health").score}, Childcare ${latestFor("childcare").score}, High Economic Impact ${latestFor("hei-points").score}.`;

const faqs = [
  {
    q: "What does the BC PNP draw calculator do?",
    a: `It compares a SIRS score with the minimum score of every 2026 BC PNP Skills Immigration draw in your stream and counts how many it would have cleared. It uses WelcomeBC's published results (${totalDraws} scored draws so far in 2026). It doesn't predict future draws.`,
  },
  {
    q: "Is a score of 98 good for BC PNP?",
    a: `It depends on your stream. In the latest draws, 98 cleared Health (${latestFor("health").score}), Construction (${latestFor("construction").score}) and Childcare (${latestFor("childcare").score}), but not Veterinary (${latestFor("veterinary").score}) or High Economic Impact (${latestFor("hei-points").score}).`,
  },
  {
    q: "Which BC PNP draw am I in?",
    a: "Your job offer's occupation decides it. Certified ECEs are in Childcare draws, priority health, veterinary and education occupations in Care draws, priority construction trades in Build draws, and every other eligible skilled job in High Economic Impact draws, which also invite by wage alone.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "BC PNP Draw Calculator",
    description,
    url: `${SITE}/bc-pnp-calculator`,
    applicationCategory: "UtilityApplication",
    operatingSystem: "Any",
    dateModified: DRAWS_LAST_UPDATED_ISO,
    offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "BC PNP Points Calculator", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "BC PNP Draw Calculator", item: `${SITE}/bc-pnp-calculator` },
    ],
  },
];

const th = "px-3 py-2.5 text-left text-xs font-black text-slate-600 uppercase tracking-wider whitespace-nowrap";
const td = "px-3 py-2 text-sm text-slate-700 whitespace-nowrap";
const h2 = "text-2xl sm:text-3xl font-black text-slate-900 tracking-tight";
const a = "text-red-700 font-semibold underline underline-offset-2 decoration-red-200 hover:decoration-red-600";
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE}/bc-pnp-calculator`}
  jsonLd={jsonLd}
  keywords="BC PNP draw calculator, will my BC PNP score get invited, BC PNP draw score, BC PNP cut off score 2026, is 98 a good BC PNP score"
>
  <section class="bg-gradient-to-b from-red-50 to-white px-4 sm:px-6 pt-6 sm:pt-12 pb-4">
    <div class="max-w-4xl mx-auto space-y-3">
      <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-red-600">Calculator</a>
        <span class="text-slate-300" aria-hidden="true">/</span>
        <span class="text-red-600 font-bold">Draw calculator</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">BC PNP Draw Calculator 2026</h1>
      <p class="text-lg text-slate-800 leading-relaxed">
        Enter your SIRS score and stream to see which of the {totalDraws} scored BC PNP draws in 2026 it would have cleared.
        Don't know your score yet? Get it first with the <a href={LINKS.calculator.href} class={a}>{LINKS.calculator.short}</a>.
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-12">
    <!-- Tool -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 space-y-4" aria-labelledby="tool">
      <h2 id="tool" class="text-xl font-black text-slate-900">Compare your score with every 2026 draw</h2>
      <form id="draw-form" class="grid gap-4 sm:grid-cols-[1fr_2fr]" onsubmit="return false">
        <label class="block text-sm font-bold text-slate-700">
          Your SIRS score (0–200)
          <input id="dc-score" type="number" min="0" max="200" step="1" inputmode="numeric" value="100"
            class="mt-1 w-full rounded-xl border-2 border-slate-200 px-3 py-2.5 text-lg font-black text-slate-900 focus:border-red-600 focus:outline-none" />
        </label>
        <label class="block text-sm font-bold text-slate-700">
          Your stream
          <select id="dc-stream" class="mt-1 w-full rounded-xl border-2 border-slate-200 px-3 py-3 text-sm font-bold text-slate-900 focus:border-red-600 focus:outline-none">
            {data.map((s) => <option value={s.key}>{s.label}</option>)}
          </select>
        </label>
      </form>
      <p id="dc-result" class="rounded-xl bg-slate-900 text-white p-4 text-base font-bold min-h-[3.5rem]" aria-live="polite">
        A score of 100 would have cleared {data[0].rows.filter((r) => (r.score as number) <= 100).length} of {data[0].rows.length} High Economic Impact draws in 2026.
      </p>
    </section>

    <!-- Tables per stream (all visible without JavaScript) -->
    <section class="space-y-8" aria-labelledby="by-stream">
      <h2 id="by-stream" class={h2}>2026 minimum scores by stream</h2>
      {
        data.map((s) => (
          <div class="dc-stream space-y-2" data-stream={s.key} data-label={s.label}>
            <h3 class="text-lg font-black text-slate-900">
              {s.label}: latest minimum {s.latest.score} ({shortDate(s.latest.date)})
            </h3>
            <p class="text-sm text-slate-600">{s.who}.</p>
            <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
              <table class="w-full">
                <caption class="sr-only">{s.label} draws in 2026</caption>
                <thead class="bg-slate-100">
                  <tr>
                    <th scope="col" class={th}>Date</th>
                    <th scope="col" class={th}>Minimum</th>
                    <th scope="col" class={th}>Invitations</th>
                    <th scope="col" class={th}>Your score</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {s.rows.map((r) => (
                    <tr data-min={r.score}>
                      <td class={`${td} font-bold text-slate-900`}>{r.date.replace(", 2026", "")}</td>
                      <td class={td}><strong>{r.score}</strong></td>
                      <td class={td}>{fmtCountShort(r.invites)}</td>
                      <td class={`${td} dc-verdict text-slate-400`}>–</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
      <p class="text-xs text-slate-500">
        Source: <a href={DRAWS_SOURCE_URL} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC, Invitations to apply</a>.
        High Economic Impact draws also invite by wage alone (no score cut-off); those rounds are on the
        <a href={LINKS.draws.href} class="underline">BC PNP draws 2026</a> page.
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="dc-faq">
      <h2 id="dc-faq" class={h2}>Draw calculator questions</h2>
      {
        faqs.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="font-black text-slate-900">{f.q}</h3>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">{f.a}</p>
          </div>
        ))
      }
    </section>
  </div>

  <RelatedLinks current="/bc-pnp-calculator" />
  <p class="max-w-4xl mx-auto px-4 sm:px-6 pb-12 text-xs text-slate-500">Past draws don't guarantee future minimums. General information, not legal advice.</p>
</BaseLayout>

<script>
  const scoreEl = document.getElementById("dc-score") as HTMLInputElement | null;
  const streamEl = document.getElementById("dc-stream") as HTMLSelectElement | null;
  const out = document.getElementById("dc-result");

  function update() {
    if (!scoreEl || !streamEl || !out) return;
    const raw = parseInt(scoreEl.value, 10);
    const score = Number.isFinite(raw) ? Math.max(0, Math.min(200, raw)) : 0;
    const stream = streamEl.value;
    let cleared = 0;
    let total = 0;
    let label = "";
    document.querySelectorAll<HTMLElement>(".dc-stream").forEach((block) => {
      const active = block.dataset.stream === stream;
      block.classList.toggle("ring-2", active);
      block.classList.toggle("ring-red-200", active);
      block.classList.toggle("rounded-2xl", active);
      if (active) label = block.dataset.label || "";
      block.querySelectorAll<HTMLTableRowElement>("tr[data-min]").forEach((row) => {
        const min = Number(row.dataset.min);
        const cell = row.querySelector<HTMLElement>(".dc-verdict");
        const ok = score >= min;
        if (active) {
          total++;
          if (ok) cleared++;
        }
        if (cell) {
          cell.textContent = ok ? `Cleared (+${score - min})` : `Missed (−${min - score})`;
          cell.className = `px-3 py-2 text-sm whitespace-nowrap dc-verdict font-bold ${ok ? "text-green-700" : "text-amber-700"}`;
        }
      });
    });
    out.textContent = `A score of ${score} would have cleared ${cleared} of ${total} ${label} draws in 2026.`;
  }

  scoreEl?.addEventListener("input", update);
  streamEl?.addEventListener("change", update);
  update();
</script>
