---
// Hub page: one line + a link for every BC PNP guide, grouped by topic.
import BaseLayout from "../layouts/BaseLayout.astro";
import RelatedLinks from "../components/seo/RelatedLinks.astro";
import LangTwin from "../components/seo/LangTwin.astro";
import { LINKS } from "../data/site-links";
import { DRAWS_SOURCE_URL } from "../data/bcpnp-draws";
import { latestDrawDate, latestDrawMinScore, latestDrawMinRow, latestFor, STREAM_SHORT } from "../utils/draws";

const SITE = "https://bcpnpcalculator.ca";
const GUIDE_URL = "https://www.welcomebc.ca/immigrate-to-b-c/bc-pnp-si-program-guide-pdf";
const SKILLS_URL = "https://www.welcomebc.ca/immigrate-to-b-c/skills-immigration";
const NEWS_URL = "https://www.welcomebc.ca/immigrate-to-b-c/about-the-bc-provincial-nominee-program/news";
const DATE_MODIFIED = "2026-11-26";

const hei = latestFor("hei-points");
const title = "BC PNP Guide 2026: Streams, Points, Draws and Fees in One Page";
const description = `2 worker streams, a 200-point score, draws as low as ${latestDrawMinScore} (${latestDrawDate}) and a $1,750 fee. How the BC PNP works in 2026, with every guide by topic.`;

type Item = { href: string; anchor: string; line: string };
const groups: { id: string; name: string; items: Item[] }[] = [
  {
    id: "eligibility",
    name: "Eligibility",
    items: [
      { href: LINKS.workExperience.href, anchor: "BC PNP work experience requirements", line: "2 years of skilled work for the Skilled Worker stream, and what counts." },
      { href: LINKS.jobOffer.href, anchor: "BC PNP job offer requirements", line: "Full-time (30+ hours), indeterminate, and paid within the Job Bank range." },
      { href: LINKS.withoutJobOffer.href, anchor: "BC PNP without a job offer", line: "Why no worker stream allows it in 2026, and what does." },
      { href: "/articles/bc-pnp-language-requirements", anchor: "BC PNP language requirements", line: "CLB 4 minimum for TEER 2–5 jobs and the tests the BC PNP accepts." },
      { href: "/articles/bc-pnp-noc-codes-teer-categories-guide-2026", anchor: "BC PNP NOC codes and TEER categories", line: "How to find your occupation code and why TEER decides your stream." },
      { href: "/articles/bc-pnp-ineligible-occupations-employers-2027", anchor: "BC PNP ineligible occupations and employers", line: "The 12 NOCs and the employer types that can't support an application." },
      { href: "/articles/bc-pnp-employer-guide", anchor: "BC PNP employer requirements", line: "What your employer must prove: years in B.C., staff count, recruitment." },
      { href: "/articles/bc-pnp-eca-guide", anchor: "BC PNP education credential assessment (ECA)", line: "When the BC PNP asks for an ECA and which agencies issue one." },
      { href: "/articles/bc-pnp-spouse-family-guide-2026", anchor: "BC PNP spouse and family", line: "Dependants, family income and open work permits." },
      { href: "/articles/bc-pnp-lmia-guide-2026", anchor: "BC PNP and LMIA", line: "When you need an LMIA for your work permit and when you don't." },
      { href: "/articles/bc-pnp-work-permit-guide", anchor: "BC PNP work permit options", line: "Staying authorized to work while you wait for a decision." },
    ],
  },
  {
    id: "streams",
    name: "Streams and occupations",
    items: [
      { href: "/articles/bc-pnp-skilled-worker-stream", anchor: "BC PNP Skilled Worker stream", line: "The main stream: TEER 0–3 job offer and 2 years of skilled experience." },
      { href: "/articles/bc-pnp-health-authority-stream", anchor: "BC PNP Health Authority stream", line: "Apply directly, without registering, with a public health authority offer." },
      { href: LINKS.caregivers.href, anchor: "BC PNP for caregivers and childcare workers", line: "ECEs and care aides yes; nannies and home support workers no." },
      { href: LINKS.ece.href, anchor: "BC PNP for early childhood educators", line: "ECE certificate, licensed employer and every 2026 Childcare draw." },
      { href: "/articles/bc-pnp-nurses-health-care-assistants-2027", anchor: "BC PNP for nurses and health care assistants", line: "Registration, stream choice and Care: Health draws." },
      { href: "/articles/bc-pnp-care-healthcare-occupations-list-2027", anchor: "BC PNP Care priority occupations list", line: "The health, childcare, education and veterinary occupations in Care draws." },
      { href: "/articles/bc-pnp-build-skilledtradesbc-certification-2027", anchor: "BC PNP Build draws for construction trades", line: "The SkilledTradesBC credential behind a Build invitation." },
      { href: "/articles/bc-pnp-skilled-trades-construction-pathway-2026", anchor: "BC PNP for skilled trades and construction workers", line: "NOC codes and scores for trades." },
      { href: LINKS.tech.href, anchor: "BC PNP tech", line: "The 35 tech NOC codes and the score tech workers need now." },
      { href: "/articles/bc-pnp-tech-stream-occupations", anchor: "BC PNP tech occupations list", line: "The former tech list and how it is used after tech draws ended." },
      { href: "/articles/tech-workers-bc-pnp-2027-after-tech-draws-ended", anchor: "Tech workers and BC PNP in 2027", line: "PR options for tech workers outside High Economic Impact draws." },
      { href: "/articles/bc-pnp-ai-cybersecurity-professionals-guide-2026", anchor: "BC PNP for AI and cybersecurity professionals", line: "Where AI and security roles fit in 2026." },
      { href: "/articles/bc-pnp-veterinarians-vet-technologists-2027", anchor: "BC PNP for veterinarians and vet technologists", line: "Licensing and Care: Veterinary draws." },
      { href: "/articles/bc-pnp-french-speaking-teachers-2027", anchor: "BC PNP for French-speaking teachers", line: "Certification and the Care: Education round." },
      { href: "/articles/bc-pnp-express-entry-bc-eebc-guide-2026", anchor: "Express Entry BC (EEBC)", line: "Using your Express Entry profile with a BC PNP stream." },
      { href: "/articles/bc-pnp-express-entry-vs-skills-immigration", anchor: "Express Entry BC vs Skills Immigration", line: "Which option to choose and how processing differs." },
      { href: "/articles/bc-pnp-entrepreneur-immigration", anchor: "BC PNP Entrepreneur Immigration", line: "The business route, the only BC PNP route without a job offer." },
      { href: "/articles/bc-pnp-international-students-graduates-pathway-2026", anchor: "BC PNP for international students and graduates", line: "What graduates can do now that student streams have closed." },
      { href: "/articles/international-graduates-bc-pr-options-2027", anchor: "International graduates in B.C.: PR options for 2027", line: "Federal and provincial alternatives." },
      { href: "/articles/bc-pnp-international-graduate-stream-2025", anchor: "BC PNP International Graduate stream (closed)", line: "What the old stream required, for reference." },
      { href: "/articles/bc-pnp-entry-level-semi-skilled", anchor: "BC PNP Entry Level and Semi-Skilled stream (closed)", line: "What the old ELSS stream covered, for reference." },
      { href: "/articles/bc-pnp-regional-priorities", anchor: "BC PNP regional priorities", line: "Area 2 and Area 3 communities and their extra points." },
      { href: "/articles/bc-pnp-look-west-regional-nominations-2027", anchor: "Look West and BC PNP regional nominations", line: "The province's regional goal and what it may mean." },
    ],
  },
  {
    id: "draws",
    name: "Scores and draws",
    items: [
      { href: LINKS.calculator.href, anchor: "BC PNP points calculator", line: "Your SIRS score out of 200 in 2 minutes." },
      { href: LINKS.drawCalculator.href, anchor: "BC PNP draw calculator", line: "Which 2026 draws your score would have cleared." },
      { href: LINKS.draws.href, anchor: "BC PNP draws 2026", line: `Every 2026 round, newest first; latest ${latestDrawDate}.` },
      { href: LINKS.hei.href, anchor: "High Economic Impact draws", line: `The draw for every other skilled job: ${hei.score} points or the wage track.` },
      { href: "/articles/bc-pnp-draw-november-13-2026", anchor: "BC PNP draw November 13, 2026", line: "The latest Care and Build round in detail." },
      { href: "/articles/bc-pnp-2026-draws-recap-2027-forecast", anchor: "BC PNP 2026 draws recap", line: "How the 2026 minimums moved and what they suggest for 2027." },
      { href: "/articles/bc-pnp-points-calculator-guide", anchor: "BC PNP points calculator guide", line: "Worked SIRS scenarios factor by factor." },
      { href: "/articles/how-to-use-bc-pnp-calculator-2026", anchor: "How to use the BC PNP calculator", line: "What to enter at each step." },
      { href: "/articles/bc-pnp-calculator-faq", anchor: "BC PNP calculator FAQ", line: "Answers to common score questions." },
      { href: "/articles/maximize-bc-pnp-score-tips", anchor: "How to increase your BC PNP score", line: "The factors that move a score most." },
      { href: "/articles/bc-pnp-vs-crs-calculator", anchor: "BC PNP score vs CRS score", line: "SIRS (200) and Express Entry CRS (1,200) compared." },
      { href: "/articles/bc-pnp-2026-allocation-priorities", anchor: "BC PNP 2026 allocation", line: "The 2026 nomination allocation and program priorities." },
      { href: "/articles/bc-pnp-statistical-report-2025-analysis", anchor: "BC PNP statistical report 2025", line: "What the 2025 numbers show." },
      { href: "/articles/bc-pnp-2027-outlook-predictions", anchor: "BC PNP 2027 outlook", line: "What to prepare for next year." },
      { href: "/articles/bc-pnp-march-2026-draws-immigration-update", anchor: "BC PNP March 2026 draws", line: "An early-2026 round in detail." },
      { href: "/articles/bc-pnp-february-2026-draw-results-analysis", anchor: "BC PNP February 2026 draws", line: "The first 2026 rounds in detail." },
    ],
  },
  {
    id: "apply",
    name: "How to apply",
    items: [
      { href: LINKS.howToApply.href, anchor: "How to apply for BC PNP", line: "6 steps from registration to your IRCC application." },
      { href: "/articles/bc-pnp-documents-checklist", anchor: "BC PNP document checklist", line: "What to gather before your invitation arrives." },
      { href: LINKS.fees.href, anchor: "BC PNP fees and costs", line: "$0 to register, $1,750 to apply, and the costs around it." },
      { href: "/articles/bc-pnp-processing-times", anchor: "BC PNP processing times", line: "How long each stage takes." },
      { href: "/articles/bc-pnp-after-ita-next-steps-guide-2026", anchor: "BC PNP after the invitation to apply", line: "Your 30 days after an invitation." },
      { href: "/articles/bc-pnp-after-nomination", anchor: "After BC PNP nomination", line: "Conditions of nomination and the IRCC application." },
      { href: "/articles/bc-pnp-refusal-appeal-reconsideration-guide-2026", anchor: "BC PNP refusal and request for review", line: "What to do after a refusal ($500 review fee)." },
      { href: "/articles/bc-pnp-common-mistakes", anchor: "Common BC PNP mistakes", line: "Errors that lead to refusals." },
      { href: "/articles/bc-pnp-job-offer-scams-fraud-2027", anchor: "BC PNP job offer scams", line: "Red flags and how to check an employer." },
      { href: "/articles/bc-pnp-questions-answered", anchor: "BC PNP questions answered", line: "Short answers to common questions." },
      { href: "/articles/ultimate-bc-pnp-guide-2026", anchor: "Ultimate BC PNP guide 2026", line: "A longer walk-through of the whole program." },
    ],
  },
];

const faqs = [
  {
    q: "Can I get BC PNP without a job offer in 2026?",
    a: "Not as a worker. The Skilled Worker and Health Authority streams both need a full-time, indeterminate B.C. job offer. Entrepreneur Immigration is the only BC PNP route without one.",
  },
  {
    q: "What score do I need for BC PNP?",
    a: `It depends on your draw. On ${latestDrawDate} the lowest minimum was ${latestDrawMinScore} (${STREAM_SHORT[latestDrawMinRow.stream]}); High Economic Impact draws, open to any other skilled job, needed ${hei.score} on ${hei.date}.`,
  },
  {
    q: "How many people does the BC PNP nominate in 2026?",
    a: "WelcomeBC announced on August 18, 2026 that the BC PNP received an additional allocation, for a 2026 total of 6,254 nominations, and plans to use it all by December 31, 2026.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    datePublished: "2026-01-01",
    dateModified: DATE_MODIFIED,
    author: { "@type": "Person", name: "Shaheer Ali Khan", url: `${SITE}/about`, jobTitle: "Regulated Canadian Immigration Consultant (RCIC)" },
    publisher: { "@type": "Organization", name: "BC PNP Calculator", url: SITE },
    mainEntityOfPage: `${SITE}/bc-pnp-guide`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "BC PNP Points Calculator", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "BC PNP Guide 2026", item: `${SITE}/bc-pnp-guide` },
    ],
  },
];

const hreflangs = [
  { lang: "en", href: `${SITE}/bc-pnp-guide` },
  { lang: "zh", href: `${SITE}/zh/bc-pnp-guide` },
  { lang: "hi", href: `${SITE}/hi/bc-pnp-guide` },
  { lang: "x-default", href: `${SITE}/bc-pnp-guide` },
];

const h2 = "text-2xl sm:text-3xl font-black text-slate-900 tracking-tight";
const p = "text-slate-700 leading-relaxed";
const a = "text-red-700 font-semibold underline underline-offset-2 decoration-red-200 hover:decoration-red-600";
const th = "px-3 py-2.5 text-left text-xs font-black text-slate-600 uppercase tracking-wider";
const td = "px-3 py-2 text-sm text-slate-700";
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} hreflangs={hreflangs} canonical={`${SITE}/bc-pnp-guide`}>
  <div class="bg-gradient-to-b from-red-50 to-white px-4 sm:px-6 pt-8 sm:pt-12 pb-6">
    <div class="max-w-4xl mx-auto space-y-4">
      <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-red-600">Calculator</a>
        <span class="text-slate-300" aria-hidden="true">/</span>
        <span class="text-red-600 font-bold">BC PNP Guide 2026</span>
      </nav>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">How does the BC PNP work in 2026?</h1>
      <p class="text-lg text-slate-800 leading-relaxed">
        The BC PNP nominates workers who have a full-time, indeterminate B.C. job offer through 2 Skills Immigration streams (Skilled Worker and
        Health Authority), ranks registrations out of 200 points, invites them in Care, Build and High Economic Impact draws, and charges $1,750 to apply.
      </p>
      <LangTwin zh="/zh/bc-pnp-guide" hi="/hi/bc-pnp-guide" />
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 space-y-12">
    <aside class="rounded-2xl border-l-4 border-red-600 bg-red-50/60 p-5" aria-label="Key facts">
      <p class="font-black text-slate-900 mb-2">Key facts</p>
      <ul class="space-y-1.5 text-sm text-slate-800 list-disc pl-5">
        <li>2026 allocation: 6,254 nominations (<a href={NEWS_URL} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC, August 18, 2026</a>).</li>
        <li>Latest draw: {latestDrawDate}, minimum scores from {latestDrawMinScore}.</li>
        <li>Registration is free and lasts up to 12 months; after an invitation you have 30 calendar days to apply.</li>
        <li>Fees: $1,750 to apply, $500 for a request for review (<a href={SKILLS_URL} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC</a>).</li>
      </ul>
    </aside>

    <section class="space-y-4" aria-labelledby="streams">
      <h2 id="streams" class={h2}>What are the BC PNP streams?</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="w-full">
          <caption class="sr-only">BC PNP streams in 2026</caption>
          <thead class="bg-slate-100">
            <tr><th scope="col" class={th}>Stream</th><th scope="col" class={th}>Who it's for</th><th scope="col" class={th}>Job offer</th><th scope="col" class={th}>Registration</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr><th scope="row" class={`${td} font-bold text-slate-900 text-left`}>Skilled Worker</th><td class={td}>Managers, professionals and skilled trades; 2 years of skilled experience</td><td class={td}>TEER 0–3, full-time, indeterminate</td><td class={td}>Register, wait for an invitation</td></tr>
            <tr><th scope="row" class={`${td} font-bold text-slate-900 text-left`}>Health Authority</th><td class={td}>Health workers employed by a B.C. public health authority</td><td class={td}>Eligible health NOC, TEER 0–3</td><td class={td}>Apply directly, no registration</td></tr>
            <tr><th scope="row" class={`${td} font-bold text-slate-900 text-left`}>Temporary Rural/Remote Health Support</th><td class={td}>Health authority cleaning and security staff in rural/remote B.C.</td><td class={td}>Current health authority job</td><td class={td}>Separate rounds</td></tr>
            <tr><th scope="row" class={`${td} font-bold text-slate-900 text-left`}>Entrepreneur Immigration</th><td class={td}>People starting or buying a B.C. business</td><td class={td}>Not needed</td><td class={td}>Register, wait for an invitation</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500">
        Sources: Part 4, <a href={GUIDE_URL} target="_blank" rel="noopener noreferrer" class="underline">Skills Immigration Program Guide</a> (June 10, 2026);
        <a href={SKILLS_URL} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC Skills Immigration</a>. Skilled Worker and Health Authority both offer an Express Entry BC option.
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="points">
      <h2 id="points" class={h2}>How are BC PNP points calculated?</h2>
      <p class={p}>
        Registrations get up to 40 points for work experience, 40 for education, 40 for language, 55 for the job offer's hourly wage and 25 for
        the area of B.C. you'll work in, 200 in all. The <a href={LINKS.calculator.href} class={a}>{LINKS.calculator.short}</a> scores all five and
        shows the breakdown; area and wage usually move a score the most.
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="draws">
      <h2 id="draws" class={h2}>How do BC PNP draws work?</h2>
      <p class={p}>
        Since May 2026 the BC PNP has run a Care and Build draw about once a month for priority health, childcare, veterinary and construction
        occupations, and a High Economic Impact draw about once a month for every other skilled job (by points, or by a wage threshold alone).
        The <a href={LINKS.draws.href} class={a}>{LINKS.draws.short}</a> page lists every round with its minimum score
        (<a href={DRAWS_SOURCE_URL} target="_blank" rel="noopener noreferrer" class="underline">source: WelcomeBC</a>).
      </p>
    </section>

    <section class="space-y-8" aria-labelledby="all-guides">
      <h2 id="all-guides" class={h2}>Every BC PNP guide, by topic</h2>
      {
        groups.map((g) => (
          <div id={g.id} class="space-y-3">
            <h3 class="text-xl font-black text-slate-900">{g.name}</h3>
            <ul class="divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white">
              {g.items.map((i) => (
                <li class="px-4 py-3 text-sm">
                  <a href={i.href} class={a}>{i.anchor}</a>
                  <span class="text-slate-600">: {i.line}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="text-sm text-slate-600">
        Guides on other provinces and federal programs are in the <a href="/guides" class={a}>immigration guides library</a>.
      </p>
    </section>

    <section class="space-y-3" aria-labelledby="guide-faq">
      <h2 id="guide-faq" class={h2}>BC PNP questions</h2>
      {
        faqs.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="font-black text-slate-900">{f.q}</h3>
            <p class="mt-2 text-sm text-slate-700 leading-relaxed">{f.a}</p>
          </div>
        ))
      }
    </section>
  </div>

  <RelatedLinks current="/bc-pnp-guide" />
  <p class="max-w-4xl mx-auto px-4 sm:px-6 pb-12 text-xs text-slate-500">Updated November 26, 2026. General information, not legal advice.</p>
</BaseLayout>
