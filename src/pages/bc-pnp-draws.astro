---
import BaseLayout from "../layouts/BaseLayout.astro";
import RelatedLinks from "../components/seo/RelatedLinks.astro";
import { DRAWS_LAST_UPDATED, DRAWS_LAST_UPDATED_ISO, DRAWS_SOURCE_URL, skillsDraws2025, poolSnapshot } from "../data/bcpnp-draws";
import { LINKS } from "../data/site-links";
import {
  skillsDraws2026,
  latestDrawRows,
  latestDrawDate,
  latestDrawInvites,
  latestDrawHasUnderFive,
  latestDrawMinScore,
  shortDate,
  streamSummaries,
  lowest2026,
  drawDays2026,
  latestFor,
  latestHeiWage,
  entrepreneurDraws2026,
  fmtCountShort,
  STREAM_SHORT,
} from "../utils/draws";

const SITE = "https://bcpnpcalculator.ca";
const fmt = (n: number) => n.toLocaleString("en-CA");

const scoredLatest = latestDrawRows.filter((r) => r.score !== null);
const latestKind = latestDrawRows.some((r) => r.stream === "hei-points") ? "Innovate: High Economic Impact" : "Care and Build";
const byScore = [...scoredLatest].sort((x, y) => (x.score as number) - (y.score as number));
const listJoin = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}` : xs[0]);
const latestScoresText = listJoin(byScore.map((r) => `${r.score} for ${STREAM_SHORT[r.stream]}`));
const invitesText = `${fmt(latestDrawInvites)}${latestDrawHasUnderFive ? "+" : ""}`;

const title = `BC PNP Draws 2026: Latest Draw ${shortDate(latestDrawDate)}, Minimum Score ${latestDrawMinScore}`;
const description = `${latestDrawDate}: ${byScore.map((r) => `${STREAM_SHORT[r.stream]} ${r.score}`).join(", ")}; ${invitesText} invitations. Every 2026 round and the score each stream needs.`;

const hei = latestFor("hei-points");
const entLatest = entrepreneurDraws2026[0];
const highPool = poolSnapshot.bands.filter((b) => ["150+", "140–149", "130–139"].includes(b.range)).reduce((n, b) => n + b.count, 0);
const under110 = poolSnapshot.bands
  .filter((b) => ["100–109", "90–99", "80–89", "70–79", "60–69", "0–59"].includes(b.range))
  .reduce((n, b) => n + b.count, 0);

const faqs = [
  {
    q: "When is the next BC PNP draw?",
    a: `WelcomeBC does not announce draw dates. In 2026 a Care and Build draw has followed roughly every month since May 6 (latest ${latestFor("health").date}) and a High Economic Impact draw has followed roughly every month since April 22 (latest ${hei.date}). WelcomeBC said on August 18, 2026 that it plans to use its full 2026 allocation of 6,254 nominations by December 31, 2026.`,
  },
  {
    q: "How often are BC PNP draws?",
    a: `There have been ${drawDays2026} Skills Immigration draw dates in 2026 so far, about two a month since May: one Care and Build round and one High Economic Impact round, plus occasional rural/remote health rounds. Entrepreneur Immigration rounds are separate and run about monthly (latest ${entLatest.date}).`,
  },
  {
    q: "What was the lowest BC PNP score in 2026?",
    a: `The lowest minimum of any 2026 Skills Immigration draw was ${lowest2026.score}, in the ${STREAM_SHORT[lowest2026.stream]} round on ${lowest2026.date}. Among the regular draws, Health reached ${streamSummaries.find((s) => s.stream === "health")!.lowest2026.score} on ${streamSummaries.find((s) => s.stream === "health")!.lowest2026.date}.`,
  },
  {
    q: "What is the minimum score for BC PNP?",
    a: `There is no fixed pass mark: every draw sets its own. On ${latestDrawDate} the minimums were ${latestScoresText}. The ${hei.date} High Economic Impact draw needed ${hei.score} points, or a wage of at least ${latestHeiWage.rule}.`,
  },
  {
    q: "Does the BC PNP still hold tech draws?",
    a: "No. WelcomeBC held the last draw for priority technology occupations on December 3, 2024. Tech workers now compete in High Economic Impact draws, which invite by wage or by points.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "BC PNP Points Calculator", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "BC PNP Draws 2026", item: `${SITE}/bc-pnp-draws` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: `${SITE}/bc-pnp-draws`,
    datePublished: "2026-01-07",
    dateModified: DRAWS_LAST_UPDATED_ISO,
  },
];

const th = "px-3 py-2.5 text-left text-xs font-black text-slate-600 uppercase tracking-wider whitespace-nowrap";
const td = "px-3 py-2 text-sm text-slate-700";
const h2 = "text-2xl sm:text-3xl font-black text-slate-900 tracking-tight";
const a = "text-red-700 font-semibold underline underline-offset-2 decoration-red-200 hover:decoration-red-600";
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE}/bc-pnp-draws`}
  jsonLd={jsonLd}
  keywords="BC PNP draws 2026, latest BC PNP draw, BC PNP draw minimum score, BC PNP cut off score, when is the next BC PNP draw, how often are BC PNP draws"
>
  <div class="bg-slate-50">
    <div class="bg-gradient-to-b from-red-50 to-white pt-8 sm:pt-12 pb-8 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto space-y-4">
        <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium" aria-label="Breadcrumb">
          <a href="/" class="hover:text-red-600">Calculator</a>
          <span class="text-slate-300" aria-hidden="true">/</span>
          <span class="text-red-600 font-bold">BC PNP Draws 2026</span>
        </nav>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">BC PNP Draws 2026</h1>
        <p class="text-lg text-slate-800 leading-relaxed">
          The latest BC PNP draw was on <strong>{latestDrawDate}</strong>, a {latestKind} Skills Immigration round: minimum scores were
          {latestScoresText}, with {invitesText} invitations{latestDrawHasUnderFive ? " (WelcomeBC reports some counts only as fewer than 5)" : ""}.
        </p>
        <p class="text-sm text-slate-600">
          The latest Entrepreneur Immigration round was on {entLatest.date} (minimum {entLatest.score}). Updated {DRAWS_LAST_UPDATED} from
          <a href={DRAWS_SOURCE_URL} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC's invitations to apply</a>.
        </p>
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 px-5 py-3 text-sm font-black text-white min-h-[44px]">
          Check your score: BC PNP points calculator →
        </a>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 space-y-14">
      <!-- Every 2026 draw -->
      <section class="space-y-4" aria-labelledby="all-draws">
        <h2 id="all-draws" class={h2}>Every 2026 BC PNP draw</h2>
        <p class="text-slate-700">
          All {drawDays2026} Skills Immigration draw dates of 2026, newest first. High Economic Impact draws invite on two tracks: a wage track with no
          score cut-off, and a points track.
        </p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
          <table class="w-full">
            <caption class="sr-only">Every 2026 BC PNP Skills Immigration draw</caption>
            <thead class="bg-slate-100">
              <tr>
                <th scope="col" class={th}>Date</th>
                <th scope="col" class={th}>Stream</th>
                <th scope="col" class={th}>Minimum score</th>
                <th scope="col" class={th}>Invitations</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {
                skillsDraws2026.map((r, i) => (
                  <tr class={i > 0 && skillsDraws2026[i - 1].iso !== r.iso ? "border-t-2 border-slate-200" : ""}>
                    <td class={`${td} font-bold text-slate-900 whitespace-nowrap`}>{r.date.replace(", 2026", "")}</td>
                    <td class={td}>{r.label}</td>
                    <td class={`${td} whitespace-nowrap`}>{r.score !== null ? <strong>{r.score}</strong> : <span class="text-slate-500">Wage: {r.rule}</span>}</td>
                    <td class={`${td} whitespace-nowrap`}>{fmtCountShort(r.invites)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-xs text-slate-500">
          Source: <a href={DRAWS_SOURCE_URL} target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC, Invitations to apply</a> (page updated
          November 17, 2026). "&lt;5" means WelcomeBC reported fewer than five invitations.
        </p>
      </section>

      <!-- What score do I need -->
      <section class="space-y-4" aria-labelledby="score-needed">
        <h2 id="score-needed" class={h2}>What score do I need for BC PNP?</h2>
        <p class="text-slate-700">
          You need at least the minimum of the draw your occupation is in. Over the last three draws of each stream the minimums were:
        </p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
          <table class="w-full">
            <caption class="sr-only">Minimum BC PNP score per stream over the last 3 and 6 draws</caption>
            <thead class="bg-slate-100">
              <tr>
                <th scope="col" class={th}>Stream</th>
                <th scope="col" class={th}>Latest</th>
                <th scope="col" class={th}>Last 3 draws</th>
                <th scope="col" class={th}>Last 6 draws</th>
                <th scope="col" class={th}>Lowest 2026</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {
                streamSummaries.map((s) => (
                  <tr>
                    <th scope="row" class={`${td} font-bold text-slate-900 text-left`}>{s.label}</th>
                    <td class={`${td} whitespace-nowrap`}><strong>{s.latest.score}</strong> ({shortDate(s.latest.date)})</td>
                    <td class={`${td} whitespace-nowrap`}>{s.last3.low === s.last3.high ? s.last3.low : `${s.last3.low}–${s.last3.high}`}</td>
                    <td class={`${td} whitespace-nowrap`}>{s.last6.low === s.last6.high ? s.last6.low : `${s.last6.low}–${s.last6.high}`}{s.last6.n < 6 ? ` (${s.last6.n} draws)` : ""}</td>
                    <td class={`${td} whitespace-nowrap`}>{s.lowest2026.score} ({shortDate(s.lowest2026.date)})</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-slate-700">
          Computed from the table above. To see which of this year's draws your own score would have cleared, use the
          <a href={LINKS.drawCalculator.href} class={a}>{LINKS.drawCalculator.short}</a>. Care draws are limited to priority occupations: certified
          ECEs for Childcare, priority health occupations for Health. Every other skilled job competes in High Economic Impact draws
          (see <a href={LINKS.hei.href} class={a}>{LINKS.hei.short}</a>).
        </p>
      </section>

      <!-- Pool -->
      <section class="space-y-4" aria-labelledby="pool">
        <h2 id="pool" class={h2}>How many people are in the BC PNP pool?</h2>
        <p class="text-slate-700">
          WelcomeBC's snapshot from {poolSnapshot.date} shows {fmt(poolSnapshot.total)} Skills Immigration registrations. Only {fmt(highPool)} scored 130 or
          more, and {fmt(under110)} ({Math.round((under110 / poolSnapshot.total) * 100)}%) scored under 110.
        </p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white max-w-md">
          <table class="w-full">
            <caption class="sr-only">BC PNP Skills Immigration pool by score, {poolSnapshot.date}</caption>
            <thead class="bg-slate-100"><tr><th scope="col" class={th}>Score</th><th scope="col" class={th}>Registrations</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
              {poolSnapshot.bands.map((b) => (<tr><td class={`${td} font-bold text-slate-900`}>{b.range}</td><td class={td}>{fmt(b.count)}</td></tr>))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Entrepreneur -->
      <section class="space-y-4" aria-labelledby="entrepreneur">
        <h2 id="entrepreneur" class={h2}>BC PNP Entrepreneur draws 2026</h2>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
          <table class="w-full">
            <caption class="sr-only">2026 BC PNP Entrepreneur Immigration rounds</caption>
            <thead class="bg-slate-100"><tr><th scope="col" class={th}>Date</th><th scope="col" class={th}>Stream</th><th scope="col" class={th}>Minimum score</th><th scope="col" class={th}>Invitations</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
              {entrepreneurDraws2026.map((d) => (<tr><td class={`${td} font-bold text-slate-900 whitespace-nowrap`}>{d.date.replace(", 2026", "")}</td><td class={td}>{d.stream}</td><td class={td}>{d.score}</td><td class={td}>{fmtCountShort(d.invites)}</td></tr>))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 2025 -->
      <section class="space-y-4" aria-labelledby="draws-2025">
        <h2 id="draws-2025" class={h2}>Late-2025 Skills Immigration draws</h2>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
          <table class="w-full">
            <caption class="sr-only">Selected 2025 BC PNP Skills Immigration draws</caption>
            <thead class="bg-slate-100"><tr><th scope="col" class={th}>Date</th><th scope="col" class={th}>Selection</th><th scope="col" class={th}>Invitations</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
              {skillsDraws2025.map((d) => (<tr><td class={`${td} font-bold text-slate-900 whitespace-nowrap`}>{d.date}</td><td class={td}>{d.rule}</td><td class={td}>{d.invites}</td></tr>))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-slate-500">
          Source: <a href="https://www.welcomebc.ca/immigrate-to-b-c/bc-pnp-invitations-to-apply-si-2025-pdf" target="_blank" rel="noopener noreferrer" class="underline">WelcomeBC 2025 invitations archive (PDF)</a>.
        </p>
      </section>

      <!-- FAQ -->
      <section class="space-y-4" aria-labelledby="draw-faq">
        <h2 id="draw-faq" class={h2}>BC PNP draw questions</h2>
        <div class="space-y-3">
          {
            faqs.map((f) => (
              <div class="rounded-2xl border border-slate-200 bg-white p-5">
                <h3 class="font-black text-slate-900">{f.q}</h3>
                <p class="mt-2 text-sm text-slate-700 leading-relaxed">{f.a}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <RelatedLinks current="/bc-pnp-draws" />
    <p class="max-w-4xl mx-auto px-4 sm:px-6 pb-12 text-xs text-slate-500">General information, not legal advice.</p>
  </div>
</BaseLayout>
